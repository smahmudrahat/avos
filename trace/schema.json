{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://avoslab.com/trace/event.schema.json",
 "title": "Avos trace event",
 "description": "One event of a trace file (JSON Lines). Contract: trace/CONTRACT.md; catalog and lifecycle: docs/trace.md. Cross-event rules (references, liveness, order, chain) are checked by trace/bin/validate and trace/bin/verify, not here.",
 "type": "object",
 "required": ["event_id", "kind", "ts", "writer", "seq", "host", "principal", "vm_id", "prev", "hash"],
 "properties": {
  "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$", "description": "Minted on the emitting host: 12 hex ms, 12 hex SHA-256(writer), 10 hex seq."},
  "kind": {"enum": ["vm.boot", "vm.exit", "session.open", "session.close", "agent.spawn", "agent.exit", "llm.call", "tool.call", "tool.result", "fs.write", "net.connect", "authz.decision", "halt", "resume", "label"]},
  "ts": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$", "description": "Host clock, UTC, ms. llm.call: completion time."},
  "writer": {"type": "string", "description": "Emitting stream, host + '/' + name."},
  "seq": {"type": "integer", "minimum": 1},
  "host": {"type": "string"},
  "principal": {"type": "string", "pattern": "^spiffe://", "description": "Who the event is about; the partition key."},
  "vm_id": {"type": "string"},
  "prev": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "run": {"type": "string", "pattern": "^run_"},
  "guest_ts": {"type": "string", "description": "A clock inside the VM; never used for ordering."},
  "receipt": {"type": "string", "pattern": "^hr_[0-9a-f]{4}$"},
  "role": {"enum": ["assistant", "user"]},
  "price": {"type": ["object", "null"], "properties": {"prompt_per_mtok": {"type": "number"}, "completion_per_mtok": {"type": "number"}, "currency": {"type": "string"}}},
  "cost_usd": {"type": ["number", "null"]},
  "agent_id": {"type": "string"},
  "call_id": {"type": "string"}
 },
 "allOf": [
  {"if": {"properties": {"kind": {"const": "vm.boot"}}}, "then": {"$ref": "#/$defs/kinds/vm.boot"}},
  {"if": {"properties": {"kind": {"const": "vm.exit"}}}, "then": {"$ref": "#/$defs/kinds/vm.exit"}},
  {"if": {"properties": {"kind": {"const": "session.open"}}}, "then": {"$ref": "#/$defs/kinds/session.open"}},
  {"if": {"properties": {"kind": {"const": "session.close"}}}, "then": {"$ref": "#/$defs/kinds/session.close"}},
  {"if": {"properties": {"kind": {"const": "agent.spawn"}}}, "then": {"$ref": "#/$defs/kinds/agent.spawn"}},
  {"if": {"properties": {"kind": {"const": "agent.exit"}}}, "then": {"$ref": "#/$defs/kinds/agent.exit"}},
  {"if": {"properties": {"kind": {"const": "llm.call"}}}, "then": {"$ref": "#/$defs/kinds/llm.call"}},
  {"if": {"properties": {"kind": {"const": "tool.call"}}}, "then": {"$ref": "#/$defs/kinds/tool.call"}},
  {"if": {"properties": {"kind": {"const": "tool.result"}}}, "then": {"$ref": "#/$defs/kinds/tool.result"}},
  {"if": {"properties": {"kind": {"const": "fs.write"}}}, "then": {"$ref": "#/$defs/kinds/fs.write"}},
  {"if": {"properties": {"kind": {"const": "net.connect"}}}, "then": {"$ref": "#/$defs/kinds/net.connect"}},
  {"if": {"properties": {"kind": {"const": "authz.decision"}}}, "then": {"$ref": "#/$defs/kinds/authz.decision"}},
  {"if": {"properties": {"kind": {"const": "halt"}}}, "then": {"$ref": "#/$defs/kinds/halt"}},
  {"if": {"properties": {"kind": {"const": "resume"}}}, "then": {"$ref": "#/$defs/kinds/resume"}},
  {"if": {"properties": {"kind": {"const": "label"}}}, "then": {"$ref": "#/$defs/kinds/label"}}
 ],
 "$defs": {
  "kinds": {
   "vm.boot": {"description": "principal = the VM; its life starts at ts - boot_ms.", "required": ["vm", "boot_ms"],
    "properties": {"vm": {"type": "string"}, "boot_ms": {"type": "integer"}}},
   "vm.exit": {"description": "principal = the VM."},
   "session.open": {"description": "principal = the VM.", "required": ["run", "harness", "task"],
    "properties": {"run": {"type": "string"}, "harness": {"type": "string"}, "task": {"type": "string"}}},
   "session.close": {"description": "principal = the VM.", "required": ["run", "status", "wall_ms"],
    "properties": {"run": {"type": "string"}, "status": {"type": "string"}, "wall_ms": {"type": "integer"}}},
   "agent.spawn": {"description": "principal = the new agent.", "required": ["spiffe_id", "parent", "name"],
    "properties": {"spiffe_id": {"type": "string"}, "parent": {"type": "string"}, "name": {"type": "string"}}},
   "agent.exit": {"description": "principal = the agent.", "required": ["spiffe_id", "exit_reason"],
    "properties": {"spiffe_id": {"type": "string"}, "exit_reason": {"type": "string"}}},
   "llm.call": {"description": "principal = the caller; ts = completion. Tokens are integers when status is 200; receipt when dropped. Content (AVOS_TRACE_CONTENT=1): input = chat messages new since the previous call that no other event carries, output = the produced message without tool calls (those are tool.call events).",
    "required": ["authz_ref", "model", "status", "ms", "prompt_tokens", "completion_tokens", "dropped"],
    "properties": {"authz_ref": {"type": "string"}, "model": {"type": "string"}, "status": {"type": "integer"}, "ms": {"type": "integer"},
     "prompt_tokens": {"type": ["integer", "null"]}, "completion_tokens": {"type": ["integer", "null"]}, "dropped": {"type": "boolean"},
     "input": {"type": "array"}, "output": {"type": "object"}, "input_sha256": {"type": "string"}, "output_sha256": {"type": "string"}}},
   "tool.call": {"description": "principal = the caller. authz_ref required when via = gateway. Gateway calls keep args (they equal the decided authz.decision.args); harness args are content.",
    "required": ["via", "tool"],
    "properties": {"via": {"enum": ["gateway", "harness"]}, "tool": {"type": "string"}, "authz_ref": {"type": "string"}, "args": {"type": "object"}, "args_sha256": {"type": "string"}}},
   "tool.result": {"description": "principal = the caller.", "required": ["call_ref"],
    "properties": {"call_ref": {"type": "string"}, "error": {"type": "boolean"}, "result_sha256": {"type": "string"}}},
   "fs.write": {"description": "principal = the writing process.", "required": ["path"], "properties": {"path": {"type": "string"}}},
   "net.connect": {"description": "principal = the caller.", "required": ["authz_ref", "dest"],
    "properties": {"authz_ref": {"type": "string"}, "dest": {"type": "string"}}},
   "authz.decision": {"description": "principal = the caller. policy_ids non-empty on deny; a receipt hr_xxxx among them marks a halt/kill/cut refusal.",
    "required": ["action", "resource", "args", "decision", "policy_ids", "errors"],
    "properties": {"action": {"enum": ["llm.call", "tool.call", "net.connect"]}, "resource": {"type": "string"}, "args": {"type": "object"},
     "decision": {"enum": ["allow", "deny"]}, "policy_ids": {"type": "array"}, "errors": {"type": "array"}}},
   "halt": {"description": "principal = target; nodes include the target.", "required": ["receipt", "action", "by", "target", "nodes", "ms"],
    "properties": {"receipt": {"type": "string"}, "action": {"type": "string"}, "by": {"type": "string"}, "target": {"type": "string"}, "nodes": {"type": "array"}, "ms": {"type": "number"}}},
   "resume": {"description": "principal = target; nodes include the target.", "required": ["receipt", "action", "by", "target", "nodes", "ms"],
    "properties": {"receipt": {"type": "string"}, "action": {"type": "string"}, "by": {"type": "string"}, "target": {"type": "string"}, "nodes": {"type": "array"}, "ms": {"type": "number"}}},
   "label": {"description": "principal = the run's agent. For τ²: labels.reward, labels.termination_reason.", "required": ["run", "labels", "source"],
    "properties": {"run": {"type": "string"}, "labels": {"type": "object"}, "source": {"type": "string"}}}
  }
 }
}
