#!/usr/bin/env bash
set -euo pipefail
ROOT=/var/lib/avos
VM=$(dirname "$0")/vm
COLLECT=$(dirname "$0")/../collect
TIMEOUT_S=${TIMEOUT_S:-1200}
RESULTS=${AVOS_RESULTS:-$ROOT/results}

ms() { echo $(($(date +%s%N) / 1000000)); }
event() { python3 "$COLLECT/store.py" emit job "$1" "$vm_id" "spiffe://avoslab.com/vm/$vm_id" "{$2}"; }
abort() {
  local rc=$?
  [ -z "${mine:-}" ] || "$VM" destroy "$name" > /dev/null || true
  [ -e "$out/job.json" ] || printf '{"run": "%s", "vm": "%s", "vm_id": "%s", "harness": "%s", "task": "%s", "status": "aborted", "stage": "%s", "exit_code": %d, "wall_ms": %d}\n' \
    "$run" "$name" "${vm_id:-}" "$harness" "$task" "${stage:-create}" "$rc" $(($(ms) - t0)) > "$out/job.json"
  [ -z "${opened:-}" ] || event session.close "\"run\":\"$run\",\"vm\":\"$name\",\"status\":\"aborted\",\"wall_ms\":$(($(ms) - t0))"
  [ -z "${vm_id:-}" ] || python3 "$COLLECT/bin/avos" trace --run "$vm_id" > "$out/events.jsonl" || true
}

run() {
  local n trial created ip ids code status agent
  harness=$1 task=$2
  t0=$(ms)
  name=${SLOT:-}
  [ -n "$name" ] || for n in $(seq 1 254); do name=vm-$(printf %02d "$n"); [ -e $ROOT/jail/firecracker/$name ] || break; done
  for trial in $(seq 0 9999); do run=run_${task/\//-}_$trial; mkdir "$RESULTS/$run" 2> /dev/null && break; done
  out=$RESULTS/$run
  trap abort EXIT
  trap 'exit 143' TERM INT
  stage=create mine=1

  created=$("$VM" create "$name" "HARNESS=$harness" "TASK=$task" ${MODEL:+"MODEL=$MODEL"} ${USER_MODEL:+"USER_MODEL=$USER_MODEL"} \
    ${JUDGE_MODEL:+"JUDGE_MODEL=$JUDGE_MODEL"}) || { rc=$?; [ $rc != 3 ] || mine=; exit $rc; }
  ip=$(grep -oP 'ip=\K\S+' <<< "$created") vm_id=$(grep -oP 'vm_id=\K\S+' <<< "$created")
  ids="\"vm\":\"$name\""
  stage=session
  event session.open "\"run\":\"$run\",$ids,\"harness\":\"$harness\",\"task\":\"$task\"" && opened=1

  stage=harness
  while code=$(curl -s -m 10 -o "$out/body" -w '%{http_code}' "http://$ip/result"); [ "$code" = 202 ]; do
    (($(ms) - t0 < TIMEOUT_S * 1000)) || { code=timeout; break; }
    sleep 2
  done
  if [ "$code" = 200 ]; then mv "$out/body" "$out/result.json"; status=done
  else mv "$out/body" "$out/error.log" 2>/dev/null || true; status=failed; fi
  "$VM" destroy "$name" > /dev/null && trap - EXIT

  local wall=$(($(ms) - t0))
  python3 - "$out" "$run" "$name" "$vm_id" "$harness" "$task" "$status" "$code" "$wall" $ROOT/images/harness.versions.json "$COLLECT" <<'EOF'
import json, os, sys
out, run, vm, vm_id, harness, task, status, http, wall, versions, collect = sys.argv[1:]
sys.path.insert(0, collect)
import store
vm_spiffe_id = f"spiffe://avoslab.com/vm/{vm_id}"
agent = [e["principal"] for e in store.vm_events(vm_id)
         if e["kind"] == "agent.spawn" and e.get("parent") == vm_spiffe_id and e.get("name") == harness]
job = {"run": run, "vm": vm, "vm_id": vm_id, "vm_spiffe_id": vm_spiffe_id, "agent_spiffe_id": agent[0] if agent else None,
       "harness": harness, "task": task, "status": status, "http": http,
       "wall_ms": int(wall), "harness_version": json.load(open(versions))[harness]}
if status == "done" and harness == "mini-swe-agent":
    r = json.load(open(f"{out}/result.json"))
    job |= {"tests_passed": r["tests_passed"], "exit_status": r["exit_status"],
            "api_calls": (r["model_stats"] or {}).get("api_calls")}
elif status == "done":
    sim = json.load(open(f"{out}/result.json"))["simulations"][0]
    job |= {"reward": (sim["reward_info"] or {}).get("reward"), "termination_reason": sim["termination_reason"]}
    if job["reward"] is None:
        job |= {"status": "failed", "error": (sim.get("info") or {}).get("error", "")[:300]}
json.dump(job, open(f"{out}/job.json", "w"), indent=1)
print(json.dumps(job))
EOF
  read -r status agent < <(python3 -c 'import json, sys; j = json.load(open(sys.argv[1])); print(j["status"], j["agent_spiffe_id"])' "$out/job.json")
  event session.close "\"run\":\"$run\",$ids,\"agent_spiffe_id\":\"$agent\",\"status\":\"$status\",\"wall_ms\":$wall" && opened=
  python3 "$COLLECT/bin/avos" trace --run "$run" > "$out/events.jsonl" || echo "$run: events not copied" >&2
  [ "$status" = done ]
}

case ${1:-} in
  run) [ $# -eq 3 ] || { echo "usage: job run <harness> <domain/task>" >&2; exit 2; }; run "$2" "$3" ;;
  *) echo "usage: job run <harness> <domain/task>" >&2; exit 2 ;;
esac
