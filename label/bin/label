#!/usr/bin/env python3
"""label: a POC 8 dataset labelled in three levels (POC 9, label/CONTRACT.md).

  label run --dataset DIR --out OUT --level 0[,1] [--run R ...] [--rubric FILE] [--gold-n N] [--seed S] [--retry-unknown]
            [--checklist]
  label view --dataset DIR --run R [--html]       the blind view of a run (no outcome, verdict or label)
  label checklist --out OUT --run R [--json]      a run's checklist next to its other layers (not before a blind label)
  label human --dataset DIR --run R --verdict pass|fail --labeller NAME [--note TEXT]
  label gold --out OUT (--next | --status)        the gold set's next unlabelled run, or its progress
  label merge --from ROOT [--from ROOT ...]       rows of other label roots (another host, another labeller)

Level 0 is the reward and POC 8's structural checks, level 1 an open-weight judge asked in two framings, level 2
the user, blind, on a stratified gold set. `--checklist` adds an advisory layer: a fast classifier answers seven
yes/no questions with a probability each; it never changes a label, it is measured against the other layers.
Every judge answer, checklist answer and human verdict is a row appended to a JSONL file
under $AVOS_LABEL_ROOT; the set of rows is the state, and `run` derives labels, gold set, M10 and the dataset card
from the dataset and those rows alone. A recorded judge answer is the label: it is never asked for again unless its
key (content, model, rubric, framing, prompt) changes. Design: docs/trace.md §11.
"""
import argparse
import concurrent.futures
import datetime
import hashlib
import html
import http.client
import json
import math
import os
import random
import re
import sys
import threading
import time
import urllib.parse
from collections import Counter

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
RUBRIC = os.path.join(HERE, "..", "rubric.json")
ROOT = os.environ.get("AVOS_LABEL_ROOT", "/var/lib/avos/labels")
JUDGE_ENV = os.environ.get("AVOS_JUDGE_ENV", "/var/lib/avos/gateway.env")
MODEL = os.environ.get("AVOS_JUDGE_MODEL", "openai/gpt-oss-120b")
CHECKLIST = os.path.join(HERE, "..", "checklist.json")
CHECK_ENV = os.environ.get("AVOS_CHECKLIST_ENV", "/var/lib/avos/checklist.env")
CHECK_MODEL = os.environ.get("AVOS_CHECKLIST_MODEL", "jev-latest")
CHECK_BASE = "https://api.typesafe.ai/v1"
YES, NO = 0.7, 0.3
JUDGE_TWIN = {"followed_instructions": "policy_followed", "correct_tools": "right_tools",
              "unsupported_claim": "hallucinated_facts", "unnecessary_actions": "unsafe_action"}

TAU2_384 = {"10", "12", "25", "50", "57", "65"}
ANSWERS = ("policy_followed", "right_tools", "hallucinated_facts", "unsafe_action")
RULE = ("Reward decides pass/fail; the judge can veto a pass; the user settles vetoes in the gold set. "
        "Flagged or incomplete items are never labelled clean.")
VERBATIM = 60
REASONS_MAX = (3, 300)
ATTEMPTS, TIMEOUT, WORKERS = 4, 120, 8
SEED, MAX_TOKENS = 300, 4000
GOLD_REQUIRED = 50
HEX64 = re.compile(r"[0-9a-f]{64}")

FRAMINGS = {
    "a": ("You review a recorded conversation between a customer-service agent and a user. Judge the agent's "
          "conduct with the rubric below.",
          "Here is the conversation, then the agent's tools. Did the agent handle the request correctly under its "
          "policy? Answer the rubric."),
    "b": ("You audit an agent's work for any mistake, however small: a skipped policy step, a wrong or missing "
          "tool call, an unsupported statement, an action nobody asked for.",
          "Rubric first, then the agent's tools and the conversation to audit. List what went wrong, if anything, "
          "and answer the rubric."),
}


class Fail(Exception):
    def __init__(self, msg, rc):
        super().__init__(msg)
        self.rc = rc


class Rejected(Exception):
    """The endpoint refused the credentials (401/403): stop at once."""


def sha(data):
    return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()


def canon(d):
    return json.dumps(d, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def dataset_dir(a):
    d = a.dataset or os.environ.get("AVOS_LABEL_DATASET")
    if not d:
        raise Fail("--dataset (or AVOS_LABEL_DATASET) is required", 2)
    for n in ("trajectories.jsonl", "manifest.json"):
        if not os.path.isfile(os.path.join(d, n)):
            raise Fail(f"{d}: no {n} (not a POC 8 export)", 2)
    return d


def harness_items(d):
    """Each run's harness-agent item (one /agent/ segment, not a sub-agent), streamed in file order."""
    seen = set()
    with open(os.path.join(d, "trajectories.jsonl"), encoding="utf-8") as f:
        for n, line in enumerate(f, 1):
            if not line.strip():
                continue
            try:
                it = json.loads(line)
                p = it["principal"]
            except (ValueError, KeyError, TypeError):
                raise Fail(f"{d}/trajectories.jsonl line {n}: not an item", 2)
            if p.count("/agent/") == 1 and "/sub/" not in p and it["run"] not in seen:
                seen.add(it["run"])
                yield it


def find_item(d, run):
    for it in harness_items(d):
        if it["run"] == run:
            return it
    return None


def content_key(it):
    """What the labeller judged: task, tools and the conversation (CONTRACT.md: the label key)."""
    msgs = []
    for m in it["messages"]:
        x = {"role": m["role"]}
        for k in ("content", "tool_call_id"):
            if k in m:
                x[k] = m[k]
        if m.get("tool_calls"):
            x["tool_calls"] = [{"name": t["function"]["name"], "arguments": t["function"]["arguments"]} for t in m["tool_calls"]]
        msgs.append(x)
    return sha(canon({"task": it["task"], "tools": it["tools"], "messages": msgs}))


def transcript_strings(it):
    out = []
    for m in it["messages"]:
        if isinstance(m.get("content"), str) and m["content"]:
            out.append(m["content"])
        for t in m.get("tool_calls") or []:
            if isinstance(t["function"].get("arguments"), str):
                out.append(t["function"]["arguments"])
    return out


def scrub(s, corpus):
    """Replace every run of ≥ VERBATIM characters that occurs verbatim in the transcript with […]."""
    while len(s) >= VERBATIM:
        cover = [False] * len(s)
        for i in range(len(s) - VERBATIM + 1):
            if s[i:i + VERBATIM] in corpus:
                cover[i:i + VERBATIM] = [True] * VERBATIM
        if not any(cover):
            break
        out, i = [], 0
        while i < len(s):
            if cover[i]:
                while i < len(s) and cover[i]:
                    i += 1
                out.append("[…]")
            else:
                out.append(s[i])
                i += 1
        s = "".join(out)
    return s


def render(it):
    """The conversation as POC 8's viewer prints it, without anything about the outcome."""
    out = []
    for i, m in enumerate(it["messages"]):
        mark = "[policy]" if m.get("train") else "[env]"
        out.append(f"#{i} tool {m.get('tool_call_id')} {mark}" if m["role"] == "tool" else f"#{i} {m['role']} {mark}")
        if m.get("event_id"):
            out.append(f"event={m['event_id']}")
        if m.get("content") is not None:
            out.append(m["content"] if isinstance(m["content"], str) else json.dumps(m["content"], ensure_ascii=False))
        for x in m.get("tool_calls") or []:
            out.append(f"tool_call {x['id']} {x['function']['name']} {x['function']['arguments']}")
    return "\n".join(out)


def level0(it):
    o, msgs = it["outcome"], it["messages"]
    term, reward = o.get("termination_reason"), o.get("reward")
    checks = {
        "item_hash": sha(canon({k: v for k, v in it.items() if k != "item_id"})) == it["item_id"],
        "trace_complete": it["trace_complete"]["status"] == "complete",
        "witness_agrees": it["witness"]["agrees"] is True,
        "no_infra_error": term not in ("infrastructure_error", "infra_error") and o.get("source") is not None
                          and not any(m.get("role") == "error" for m in msgs),
        "no_context_overflow": "context_window_exceeded" not in str(term or "")
                               and not any("context_window_exceeded" in m["content"] for m in msgs if isinstance(m.get("content"), str)),
        "reward_known": isinstance(reward, (int, float)) and not isinstance(reward, bool)}
    structural = all(checks.values())
    informative = not (it.get("harness") == "tau2" and str(it.get("task", "")).startswith("retail/")
                       and str(it.get("task_id")) in TAU2_384)
    return {"reward": reward, "passed": o.get("passed"), "termination_reason": term,
            "trace_complete": it["trace_complete"]["status"], "witness_agrees": it["witness"]["agrees"],
            "checks": checks, "structural_ok": structural, "reward_informative": informative,
            "status": "clean" if structural and informative else "not_clean",
            "reasons": [k for k, v in checks.items() if not v] + ([] if informative else ["tau2_384"])}


def judged(it):
    return it["witness"]["agrees"] is True and any(m.get("train") for m in it["messages"])


def row_problem(row):
    """Why a stored row cannot be applied, or None."""
    if not isinstance(row, dict) or row.get("label_id") != sha(canon({k: v for k, v in row.items() if k != "label_id"})):
        return "label_id does not match the row"
    try:
        datetime.datetime.fromisoformat(row["ts"].replace("Z", "+00:00"))
        ok = all(isinstance(row[k], str) and HEX64.fullmatch(row[k]) for k in ("content_sha256", "item_id")) \
            and isinstance(row["run"], str)
        if row["level"] == 1:
            a = row["answers"]
            ok = ok and row["labeller"] == "model:" + str(row["model"]) and row["framing"] in FRAMINGS \
                and HEX64.fullmatch(str(row["rubric_sha256"])) and isinstance(row["reasons"], list) \
                and row["error"] in (None, "judge_invalid") and isinstance(row["attempts"], int) \
                and (row["verdict"] == "unknown" and a is None
                     or isinstance(a, dict) and all(isinstance(a.get(k), bool) for k in ANSWERS) and row["verdict"] == verdict_of(a))
        elif row["level"] == 2:
            ok = ok and str(row["labeller"]).startswith("human:") and row["verdict"] in ("pass", "fail") \
                and (row["note"] is None or isinstance(row["note"], str))
        elif row["level"] == 3:
            a = row["answers"]
            ok = ok and row["labeller"] == "model:" + str(row["model"]) and HEX64.fullmatch(str(row["checklist_sha256"])) \
                and isinstance(row["attempts"], int) and isinstance(a, dict) and a \
                and all(isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1 for v in a.values())
        else:
            ok = False
    except (KeyError, TypeError, ValueError, AttributeError):
        ok = False
    return None if ok else "not a label row"


def read_root(root):
    """(rows by label_id, invalid [{file, line, reason}]) from every *.jsonl directly under root."""
    rows, invalid = {}, []
    if not os.path.isdir(root):
        return rows, invalid
    for name in sorted(os.listdir(root)):
        p = os.path.join(root, name)
        if not name.endswith(".jsonl") or not os.path.isfile(p):
            continue
        with open(p, "rb") as f:
            data = f.read()
        for n, raw in enumerate(data.split(b"\n"), 1):
            if not raw.strip():
                continue
            try:
                row = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, ValueError):
                row = None
            why = "not a complete JSON object" if not isinstance(row, dict) else row_problem(row)
            if why:
                invalid.append({"file": name, "line": n, "reason": why})
            else:
                rows[row["label_id"]] = row
    return rows, invalid


def newest(rows):
    return max(rows, key=lambda r: (r["ts"], r["label_id"]), default=None)


class Store:
    """Appends rows to one file per labeller under the root; never edits a line."""

    def __init__(self, root):
        self.root = root

    def append(self, rows):
        if not rows:
            return
        os.makedirs(self.root, exist_ok=True)
        by = {}
        for r in rows:
            by.setdefault(re.sub(r"[^A-Za-z0-9._-]+", "_", r["labeller"]) + ".jsonl", []).append(r)
        for name, rs in by.items():
            fd = os.open(os.path.join(self.root, name), os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
            try:
                size = os.fstat(fd).st_size
                torn = size and os.pread(fd, 1, size - 1) != b"\n"
                data = "".join(json.dumps(r, sort_keys=True, ensure_ascii=True) + "\n" for r in rs)
                os.write(fd, (b"\n" if torn else b"") + data.encode())
                os.fsync(fd)
            finally:
                os.close(fd)


def make_row(**fields):
    return {"label_id": sha(canon(fields)), **fields}


def env_file(path, what):
    try:
        with open(path, encoding="utf-8") as f:
            env = dict(l.strip().split("=", 1) for l in f if "=" in l and not l.lstrip().startswith("#"))
    except OSError:
        raise Fail(f"{what} env file {path} is not readable", 2)
    return {k.strip(): v.strip().strip("'\"") for k, v in env.items()}


def read_env(path):
    env = env_file(path, "judge")
    base = os.environ.get("AVOS_JUDGE_BASE_URL") or env.get("OPENAI_BASE_URL")
    if not env.get("OPENAI_API_KEY") or not base:
        raise Fail(f"judge env file {path} lacks OPENAI_API_KEY or OPENAI_BASE_URL", 2)
    return base, env["OPENAI_API_KEY"]


def read_check_env(path):
    env = env_file(path, "checklist")
    if not env.get("TYPESAFE_API_KEY"):
        raise Fail(f"checklist env file {path} lacks TYPESAFE_API_KEY", 2)
    return env.get("TYPESAFE_BASE_URL") or CHECK_BASE, env["TYPESAFE_API_KEY"]


def prompt_sha(framing):
    return sha(canon({"framing": FRAMINGS[framing], "seed": SEED, "max_tokens": MAX_TOKENS, "temperature": 0}))


def request_body(it, framing, rubric, model):
    system, ask = FRAMINGS[framing]
    tools = "\n".join(f"- {t['function']['name']}: {t['function'].get('description', '')}" for t in it["tools"])
    convo = render(it)
    if framing == "a":
        msgs = [{"role": "system", "content": f"{system}\n\nRubric:\n{rubric}"},
                {"role": "user", "content": f"{ask}\n\nConversation ({it['task']}):\n{convo}\n\nTools:\n{tools}"}]
    else:
        msgs = [{"role": "system", "content": system},
                {"role": "user", "content": f"{ask}\n\nRubric:\n{rubric}\n\nTools:\n{tools}\n\nConversation to audit:\n{convo}"}]
    return json.dumps({"model": model, "messages": msgs, "temperature": 0, "seed": SEED, "max_tokens": MAX_TOKENS,
                       "user": it["item_id"], "response_format": {"type": "json_object"}}).encode()


def parse_answer(data):
    """(answers, reasons, usage, response_id) from a 2xx body, or None when it is not a valid rubric answer."""
    try:
        d = json.loads(data)
        ch = d["choices"][0]
        if ch.get("finish_reason") == "length":
            return None
        text = ch["message"]["content"].strip()
        m = re.fullmatch(r"```(?:json)?\s*(.*?)\s*```", text, re.S)
        a = json.loads(m.group(1) if m else text)
        if not isinstance(a, dict) or not all(isinstance(a.get(k), bool) for k in ANSWERS):
            return None
        u = d.get("usage") or {}
        usage = {k: u[k] for k in ("prompt_tokens", "completion_tokens") if isinstance(u.get(k), int)} or None
        reasons = [r for r in a.get("reasons") or [] if isinstance(r, str)] if isinstance(a.get("reasons"), list) else []
        return {k: a[k] for k in ANSWERS}, reasons, usage, d.get("id") if isinstance(d.get("id"), str) else None
    except (ValueError, KeyError, IndexError, TypeError, AttributeError):
        return None


def verdict_of(a):
    return "veto" if (not a["policy_followed"] or not a["right_tools"] or a["hallucinated_facts"] or a["unsafe_action"]) else "pass"


class Judge:
    """A JSON endpoint (the judge's chat completions, the checklist's system-one) over one kept-alive connection
    per worker thread."""

    def __init__(self, base, key, endpoint="/chat/completions", name="judge"):
        u = urllib.parse.urlsplit(base)
        if u.scheme not in ("http", "https") or not u.hostname:
            raise Fail(f"{name} base URL is not http(s)", 2)
        self.name = name
        self.cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
        self.host, self.port, self.path = u.hostname, u.port, u.path.rstrip("/") + endpoint
        self.headers = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
        self.local, self.stop = threading.local(), threading.Event()
        self.lock, self.calls = threading.Lock(), 0

    def post(self, body):
        with self.lock:
            self.calls += 1
        for fresh in (False, True):
            c = getattr(self.local, "c", None)
            reused = c is not None
            if c is None:
                c = self.local.c = self.cls(self.host, self.port, timeout=TIMEOUT)
            try:
                c.request("POST", self.path, body, self.headers)
                r = c.getresponse()
                return r.status, r.read()
            except (http.client.RemoteDisconnected, BrokenPipeError, ConnectionResetError):
                c.close()
                self.local.c = None
                if not reused or fresh:
                    raise
            except (OSError, http.client.HTTPException):
                c.close()
                self.local.c = None
                raise

    def ask(self, it, framing, rubric, model):
        """One framing, ≤ ATTEMPTS attempts: ('ok', parsed, n) | ('invalid', None, n) | ('unavailable', None, n)."""
        body = request_body(it, framing, rubric, model)
        content_failures = 0
        for n in range(1, ATTEMPTS + 1):
            if self.stop.is_set():
                raise Rejected(self.name)
            try:
                status, data = self.post(body)
            except (OSError, http.client.HTTPException):
                status, data = None, b""
            if status in (401, 403):
                self.stop.set()
                raise Rejected(self.name)
            if status is not None and 200 <= status < 300:
                got = parse_answer(data)
                if got:
                    return "ok", got, n
                content_failures += 1
            elif n < ATTEMPTS:
                time.sleep(0.5 * 2 ** (n - 1))
        return ("invalid" if content_failures == ATTEMPTS else "unavailable"), None, ATTEMPTS

    def check(self, it, questions, model):
        """The checklist, ≤ ATTEMPTS attempts: ('ok', (answers, model_version, usage), n) | ('unavailable', reason, n).
        Advisory, so nothing is stored for a failure: the next run asks again."""
        tools = "\n".join(f"- {t['function']['name']}: {t['function'].get('description', '')}" for t in it["tools"])
        body = json.dumps({"model": model, "state": {"task": it["task"], "tools": tools, "conversation": render(it)},
                           "questions": {q: {"type": "noul", "instructions": v["text"]} for q, v in questions.items()}}).encode()
        for n in range(1, ATTEMPTS + 1):
            if self.stop.is_set():
                raise Rejected(self.name)
            try:
                status, data = self.post(body)
            except (OSError, http.client.HTTPException):
                status, data = None, b""
            if status in (401, 403):
                self.stop.set()
                raise Rejected(self.name)
            if status is not None and 200 <= status < 300:
                try:
                    d = json.loads(data)
                    a = {q: d["answers"][q]["noul"] for q in questions}
                    if all(isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1 for v in a.values()):
                        u = d.get("usage") or {}
                        usage = {k: u[k] for k in ("input_tokens", "output_tokens") if isinstance(u.get(k), int)} or None
                        return "ok", (a, d.get("model") if isinstance(d.get("model"), str) else None, usage), n
                except (ValueError, KeyError, TypeError, AttributeError):
                    pass
            elif status is not None and status not in (408, 429) and status < 500:
                try:
                    why = json.loads(data)["detail"]["error_type"]
                except (ValueError, KeyError, TypeError):
                    why = None
                return "unavailable", f"refused: {why if isinstance(why, str) else f'HTTP {status}'}"[:80], n
            if n < ATTEMPTS:
                time.sleep(0.5 * 2 ** (n - 1))
        return "unavailable", "unavailable" if status is None or 200 <= status < 300 else f"HTTP {status}", n


def checklist_view(row, questions):
    """A stored checklist row as answers (YES / NO / UNSURE, p(yes), confidence |2p − 1|) and one verdict:
    fail when any answer is the bad one, unsure when any is UNSURE, else pass."""
    if row is None:
        return {"status": "unanswered"}
    answers = {}
    for q in questions:
        p = row["answers"][q]
        answers[q] = {"answer": "YES" if p >= YES else "NO" if p <= NO else "UNSURE", "p": p,
                      "confidence": round(abs(2 * p - 1), 4)}
    got = [(answers[q]["answer"], questions[q]["good"].upper()) for q in questions]
    verdict = "fail" if any(x not in (good, "UNSURE") for x, good in got) else "unsure" if any(x == "UNSURE" for x, _ in got) else "pass"
    return {"status": "answered", "model": row["model"], "model_version": row["model_version"], "label_id": row["label_id"],
            "verdict": verdict, "answers": answers}


def judge_answer(l1, key):
    """The judge's answer to one rubric question when its framings agree on it, else None."""
    vals = {f["answers"][key] for f in (l1 or {}).get("framings", {}).values() if f["answers"]}
    return vals.pop() if len(vals) == 1 else None


def kappa(a, b, c, d):
    n = a + b + c + d
    k = {"n": n, "a": a, "b": b, "c": c, "d": d, "po": None, "pe": None, "value": None, "se": None, "ci95": None,
         "status": "unverified", "reason": None}
    if n == 0:
        k["reason"] = "n=0 < 50"
        return k
    po = (a + d) / n
    pe = ((a + b) * (a + c) + (c + d) * (b + d)) / (n * n)
    k["po"], k["pe"] = po, pe
    if n < GOLD_REQUIRED:
        k["reason"] = f"n={n} < {GOLD_REQUIRED}"
    elif pe >= 1:
        k["reason"] = "pe=1"
    else:
        v = (po - pe) / (1 - pe)
        se = math.sqrt(po * (1 - po) / (n * (1 - pe) ** 2))
        k.update({"value": v, "se": se, "ci95": [v - 1.96 * se, v + 1.96 * se], "status": "measured"})
    return k


def m10(rows, gold_runs):
    tabs = {"judge": [0, 0, 0, 0], "reward": [0, 0, 0, 0]}
    for r in rows:
        if r["run"] not in gold_runs or not r["level2"]:
            continue
        h = r["level2"]["verdict"] == "pass"
        v = (r["level1"] or {}).get("verdict")
        raters = {"judge": v == "pass" if v in ("pass", "veto") else None,
                  "reward": r["level0"]["passed"] if isinstance(r["level0"]["passed"], bool) and r["level0"]["reward_informative"] else None}
        for name, p in raters.items():
            if p is not None:
                tabs[name][(0 if p else 2) + (0 if h else 1)] += 1
    labelled = sum(1 for r in rows if r["run"] in gold_runs and r["level2"])
    return {"gold": {"selected": len(gold_runs), "labelled": labelled, "required": GOLD_REQUIRED},
            "kappa_judge_human": kappa(*tabs["judge"]), "kappa_reward_human": kappa(*tabs["reward"])}


def final(l0, l1, l2):
    if not l0["structural_ok"]:
        return "fail", "level0"
    if l2 and (l0["passed"] is True or not l0["reward_informative"]):
        return l2["verdict"], "human"
    if not l0["reward_informative"]:
        return "fail", "tau2_384"
    if l0["passed"] is not True:
        return "fail", "reward"
    if l1 and l1["verdict"] == "veto":
        return "fail", "veto"
    return "pass", "reward"


def stratum(l0, l1):
    if l0["witness_agrees"] is not True or not l0["checks"]["reward_known"]:
        return None
    if not l0["reward_informative"]:
        return "disagree"
    v = (l1 or {}).get("verdict")
    if v in ("pass", "veto") and (v == "pass") != bool(l0["passed"]):
        return "disagree"
    return "passed" if l0["passed"] else "failed"


def gold_set(rows, n, seed):
    strata = {"disagree": [], "passed": [], "failed": []}
    for r in rows:
        if r["stratum"]:
            strata[r["stratum"]].append(r["run"])
    rnd = random.Random(seed)
    quota = {"disagree": n - 2 * (n // 3), "passed": n // 3, "failed": n // 3}
    picked = {s: rnd.sample(sorted(strata[s]), min(quota[s], len(strata[s]))) for s in strata}
    left = n - sum(map(len, picked.values()))
    for s in strata:
        rest = sorted(set(strata[s]) - set(picked[s]))
        k = min(left, len(rest))
        if k:
            picked[s] += rnd.sample(rest, k)
            left -= k
    runs = sorted(r for v in picked.values() for r in v)
    done = {r["run"] for r in rows if r["level2"]}
    return {"n": n, "seed": seed, "strata": {s: sorted(v) for s, v in strata.items()}, "picked": picked, "runs": runs,
            "short": sum(map(len, strata.values())) < GOLD_REQUIRED, "labelled": [r for r in runs if r in done],
            "left": [r for r in runs if r not in done]}


def checklist_summary(rows, views, gold_runs, questions, check_sha, calls_made, calls_reused):
    """How the checklist answered, and how far each layer agrees with it: kappa against the human on the gold set
    (its verdict, unsure left out) and, per shared question, agreement with the judge where the judge's framings
    agree (UNSURE left out). Advisory: none of this feeds a label."""
    answered = [v for v in views.values() if v["status"] == "answered"]
    tab = [0, 0, 0, 0]
    for r in rows:
        v = views.get(r["run"])
        if r["run"] in gold_runs and r["level2"] and v and v["status"] == "answered" and v["verdict"] != "unsure":
            tab[(0 if v["verdict"] == "pass" else 2) + (0 if r["level2"]["verdict"] == "pass" else 1)] += 1
    twin = {}
    for q, key in JUDGE_TWIN.items():
        pairs = [(views[r["run"]]["answers"][q]["answer"] == "YES", judge_answer(r["level1"], key)) for r in rows
                 if r["run"] in views and views[r["run"]]["status"] == "answered"
                 and views[r["run"]]["answers"][q]["answer"] != "UNSURE"]
        pairs = [(c, j) for c, j in pairs if j is not None]
        agree = sum(1 for c, j in pairs if c == j)
        twin[q] = {"judge_question": key, "n": len(pairs), "agree": agree, "rate": agree / len(pairs) if pairs else None}
    return {"model": CHECK_MODEL, "model_versions": sorted({v["model_version"] for v in answered if v["model_version"]}),
            "checklist_sha256": check_sha, "calls_made": calls_made, "calls_reused": calls_reused,
            "eligible": len(views), "answered": len(answered), "unanswered": len(views) - len(answered),
            "unanswered_reasons": dict(sorted(Counter(v.get("reason", "unavailable") for v in views.values()
                                                      if v["status"] != "answered").items())),
            "verdicts": dict(sorted(Counter(v["verdict"] for v in answered).items())),
            "unsure": {q: sum(1 for v in answered if v["answers"][q]["answer"] == "UNSURE") for q in questions},
            "kappa_checklist_human": kappa(*tab), "agreement_with_judge": twin}


def kappa_line(name, k):
    if k["status"] == "measured":
        return f"M10 kappa({name}, human) = {k['value']:.3f} (95% CI {k['ci95'][0]:.3f}–{k['ci95'][1]:.3f}, n={k['n']})"
    return f"M10 kappa({name}, human): unverified ({k['reason']})"


def card(summary, manifest, labels):
    s, j = summary, summary["judge"]
    c = j["consistency"]
    lines = ["# Dataset card: labels", "",
             f"- Dataset `{s['dataset']['dataset_sha256']}` ({s['dataset']['runs']} runs), label set `{labels['label_set_sha256']}`",
             f"- {s['tiles']['labelled']}", f"- {s['tiles']['kept']}",
             f"- Levels: {', '.join(map(str, s['levels']))}; by rule: "
             + ", ".join(f"{k} {v}" for k, v in s["counts"]["by_rule"].items()),
             f"- Judge: `{s['model']}`, rubric sha256 `{s['rubric_sha256']}`" if s["model"] else "- Judge: not run (level 0 only)",
             f"- Judge consistency across two framings: {c['rate']:.3f} ({c['agree']} of {c['n']} runs)" if c["rate"] is not None
             else "- Judge consistency across two framings: not measured (no run with both framings answered)",
             f"- {kappa_line('judge', s['m10']['kappa_judge_human'])}", f"- {kappa_line('reward', s['m10']['kappa_reward_human'])}",
             f"- Gold set: {s['m10']['gold']['labelled']} of {s['m10']['gold']['selected']} selected runs labelled blind "
             f"({s['m10']['gold']['required']} required for a kappa)",
             f"- M14 after veto: {labels['m14_after_veto']['train_kept']} kept of {labels['m14_after_veto']['train_runs']} train-split runs",
             f"- Rule: {RULE}"]
    c = s.get("checklist")
    if c:
        lines += [f"- Checklist (advisory, never changes a label): `{c['model']}` ({', '.join(c['model_versions']) or 'no answer yet'}), "
                  f"{c['answered']} of {c['eligible']} runs answered; verdicts "
                  + (", ".join(f"{k} {v}" for k, v in c["verdicts"].items()) or "none"),
                  f"- {kappa_line('checklist', c['kappa_checklist_human'])}"]
    return "\n".join(lines + [""])


def write_outputs(out, files):
    os.makedirs(out, exist_ok=True)
    for name, text in files.items():
        tmp = os.path.join(out, f".{name}.tmp-{os.getpid()}")
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, os.path.join(out, name))


def cmd_run(a):
    d = dataset_dir(a)
    levels = {"0": [0], "0,1": [0, 1], "1": [0, 1], "1,0": [0, 1]}.get(a.level)
    if levels is None:
        raise Fail(f"--level {a.level}: want 0 or 0,1", 2)
    if os.path.realpath(a.out) == os.path.realpath(d):
        raise Fail("--out must not be the dataset directory", 2)
    with open(os.path.join(d, "manifest.json"), encoding="utf-8") as f:
        dman = json.load(f)
    gold_n = max(GOLD_REQUIRED, min(100, a.gold_n))
    level1 = 1 in levels
    rubric = rubric_sha = None
    if level1:
        with open(a.rubric or RUBRIC, "rb") as f:
            raw = f.read()
        rubric, rubric_sha = raw.decode("utf-8"), sha(raw)
    questions = check_sha = None
    if a.checklist:
        with open(CHECKLIST, "rb") as f:
            raw = f.read()
        questions, check_sha = json.loads(raw)["questions"], sha(raw)
    stored, invalid = read_root(ROOT)
    l1_index, l2_by_key, l2_by_run, l3_index = {}, {}, {}, {}
    for r in stored.values():
        if r["level"] == 1 and r["model"] == MODEL and r["rubric_sha256"] == rubric_sha \
                and r.get("prompt_sha256") == prompt_sha(r["framing"]):
            k = (r["run"], r["content_sha256"], r["framing"])
            if k not in l1_index or (r["ts"], r["label_id"]) > (l1_index[k]["ts"], l1_index[k]["label_id"]):
                l1_index[k] = r
        elif r["level"] == 2:
            l2_by_key.setdefault((r["run"], r["content_sha256"]), []).append(r)
            l2_by_run.setdefault(r["run"], []).append(r)
        elif r["level"] == 3 and r["model"] == CHECK_MODEL and r["checklist_sha256"] == check_sha \
                and set(r["answers"]) == set(questions):
            k = (r["run"], r["content_sha256"])
            if k not in l3_index or (r["ts"], r["label_id"]) > (l3_index[k]["ts"], l3_index[k]["label_id"]):
                l3_index[k] = r
    want = set(a.run or [])

    rows, framings, checks, unanswered, store, judge, checker = {}, {}, {}, {}, Store(ROOT), None, None
    reused = check_reused = 0
    pending, ex = {}, None

    def submit(fn, *args, tag):
        nonlocal ex
        if ex is None:
            ex = concurrent.futures.ThreadPoolExecutor(WORKERS)
        pending[ex.submit(fn, *args)] = tag
        if len(pending) >= 4 * WORKERS:
            settle(concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED).done)

    def settle(done):
        for fut in done:
            run, fr, it_sha, item_id, corpus = pending.pop(fut)
            kind, got, n = fut.result()
            if fr == "checklist":
                if kind != "ok":
                    unanswered[run] = got
                if kind == "ok":
                    answers, version, usage = got
                    row = make_row(level=3, content_sha256=it_sha, item_id=item_id, run=run, labeller=f"model:{CHECK_MODEL}",
                                   ts=now(), model=CHECK_MODEL, model_version=version, checklist_sha256=check_sha,
                                   answers=answers, attempts=n, usage=usage)
                    store.append([row])
                    checks[run] = row
                continue
            if kind == "unavailable":
                framings[run][fr] = {"label_id": None, "verdict": "unknown", "answers": None, "reasons": [], "error": "judge_unavailable"}
                continue
            answers, reasons, usage, rid = got if got else (None, [], None, None)
            reasons = [scrub(x, corpus)[:REASONS_MAX[1]] for x in reasons[:REASONS_MAX[0]]]
            row = make_row(level=1, content_sha256=it_sha, item_id=item_id, run=run, labeller=f"model:{MODEL}", ts=now(),
                           verdict=verdict_of(answers) if answers else "unknown", model=MODEL, rubric_sha256=rubric_sha,
                           prompt_sha256=prompt_sha(fr), framing=fr, answers=answers, reasons=reasons,
                           error=None if answers else "judge_invalid", attempts=n, usage=usage, response_id=rid)
            store.append([row])
            framings[run][fr] = row

    try:
        for it in harness_items(d):
            run = it["run"]
            if want and run not in want:
                continue
            c_sha = content_key(it)
            rows[run] = {"run": run, "item_id": it["item_id"], "content_sha256": c_sha, "task": it["task"],
                         "task_id": it.get("task_id"), "split": it.get("split"), "level0": level0(it)}
            if not judged(it):
                continue
            if a.checklist:
                checks[run] = None
                r = l3_index.get((run, c_sha))
                if r:
                    checks[run] = r
                    check_reused += 1
                else:
                    if checker is None:
                        checker = Judge(*read_check_env(CHECK_ENV), endpoint="/systemone", name="checklist")
                    submit(checker.check, it, questions, CHECK_MODEL, tag=(run, "checklist", c_sha, it["item_id"], None))
            if not level1:
                continue
            framings[run] = {}
            corpus = None
            for fr in FRAMINGS:
                r = l1_index.get((run, c_sha, fr))
                if r and not (a.retry_unknown and r["verdict"] == "unknown"):
                    framings[run][fr] = r
                    reused += 1
                    continue
                if judge is None:
                    judge = Judge(*read_env(JUDGE_ENV))
                if corpus is None:
                    corpus = "\x00".join(transcript_strings(it))
                submit(judge.ask, it, fr, rubric, MODEL, tag=(run, fr, c_sha, it["item_id"], corpus))
        while pending:
            settle(concurrent.futures.wait(pending, return_when=concurrent.futures.FIRST_COMPLETED).done)
    except Rejected as e:
        raise Fail(f"the {e} endpoint rejected the credentials (HTTP 401/403)", 2)
    finally:
        if ex:
            ex.shutdown(wait=False, cancel_futures=True)
    if want - set(rows):
        raise Fail(f"run(s) not in the dataset: {', '.join(sorted(want - set(rows)))}", 2)

    stale = []
    out_rows = []
    for run in sorted(rows):
        r = rows[run]
        l1 = None
        if run in framings:
            fr = {k: {"label_id": x["label_id"], "verdict": x["verdict"],
                      "answers": x["answers"] and {q: x["answers"][q] for q in ANSWERS}, "reasons": x["reasons"],
                      "error": x["error"]} for k, x in framings[run].items()}
            vs = [fr[k]["verdict"] for k in FRAMINGS]
            l1 = {"model": MODEL, "rubric_sha256": rubric_sha,
                  "verdict": "veto" if "veto" in vs else "pass" if "pass" in vs else "unknown",
                  "framings": {k: fr[k] for k in FRAMINGS},
                  "consistent": vs[0] == vs[1] if "unknown" not in vs else None,
                  "reasons": [x for k in FRAMINGS for x in fr[k]["reasons"]]}
        hs = l2_by_key.get((run, r["content_sha256"]), [])
        cur = newest(hs)
        l2 = cur and {"labeller": cur["labeller"], "verdict": cur["verdict"], "label_id": cur["label_id"], "ts": cur["ts"], "history": len(hs)}
        for x in sorted(l2_by_run.get(run, []), key=lambda x: x["label_id"]):
            if x["content_sha256"] != r["content_sha256"]:
                stale.append({"run": run, "label_id": x["label_id"], "labelled_content_sha256": x["content_sha256"],
                              "current_content_sha256": r["content_sha256"], "labelled_item_id": x["item_id"],
                              "current_item_id": r["item_id"], "labeller": x["labeller"]})
        label, rule = final(r["level0"], l1, l2)
        out_rows.append({**r, "level1": l1, "level2": l2, "final": {"label": label, "rule": rule, "kept": label == "pass"},
                         "stratum": stratum(r["level0"], l1)})
    views = {run: {"run": run, "content_sha256": rows[run]["content_sha256"], **checklist_view(checks[run], questions),
                   **({"reason": unanswered[run]} if run in unanswered else {})} for run in sorted(checks)}

    relabelled = {r["run"] for r in out_rows if r["level2"]}
    gold = gold_set(out_rows, gold_n, a.seed)
    gold_runs = set(gold["runs"])
    quality = m10(out_rows, gold_runs)
    n_rows = len(out_rows)
    kept = sum(1 for r in out_rows if r["final"]["kept"])
    cons = [r["level1"]["consistent"] for r in out_rows if r["level1"] and r["level1"]["consistent"] is not None]
    unknown = sum(1 for r in out_rows if r["level1"] and r["level1"]["verdict"] == "unknown")
    hash_bad = sum(1 for r in out_rows if not r["level0"]["checks"]["item_hash"])
    open_stale = sorted({x["run"] for x in stale if x["run"] not in relabelled})
    rc = 1 if unknown or open_stale or invalid or hash_bad else 0
    runs_m = dman["counts"]["runs_exported"]
    summary = {
        "format": "avos-label-summary/1",
        "dataset": {"path_sha256": None, "dataset_sha256": dman.get("dataset_sha256"), "runs": runs_m},
        "levels": levels, "model": MODEL if level1 else None, "rubric_sha256": rubric_sha if level1 else None, "seed": a.seed,
        "counts": {"labelled": n_rows, "kept": kept, "dropped": n_rows - kept,
                   "clean": sum(1 for r in out_rows if r["level0"]["status"] == "clean"),
                   "not_clean": sum(1 for r in out_rows if r["level0"]["status"] != "clean"),
                   "by_rule": dict(sorted(Counter(r["final"]["rule"] for r in out_rows).items())),
                   "level0_reasons": dict(sorted(Counter(x for r in out_rows for x in r["level0"]["reasons"]).items())),
                   "judged": sum(1 for r in out_rows if r["level1"]), "judge_unknown": unknown,
                   "human_labelled": sum(1 for r in out_rows if r["level2"])},
        "judge": {"calls_made": judge.calls if judge else 0, "calls_reused": reused,
                  "consistency": {"n": len(cons), "agree": sum(cons), "rate": sum(cons) / len(cons) if cons else None}},
        "tiles": {"labelled": f"{n_rows} / {runs_m} runs labelled",
                  "kept": f"kept {kept} passed runs → training set · dropped {n_rows - kept} failed"},
        "m10": quality, "stale_labels": stale, "invalid_rows": invalid, "exit": rc}
    if a.checklist:
        summary["checklist"] = checklist_summary(out_rows, views, gold_runs, questions, check_sha,
                                                 checker.calls if checker else 0, check_reused)

    labels_text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in out_rows)
    by_run = {r["run"]: r for r in out_rows}
    train = [r for r in out_rows if r["split"] == "train"]
    train_kept = sum(1 for r in train if r["final"]["kept"])
    labels = {"items": [{"item_id": x["item_id"], "run": x["run"],
                         **({k: by_run[x["run"]]["final"][k] for k in ("label", "rule", "kept")}
                            if x["run"] in by_run and by_run[x["run"]]["item_id"] == x["item_id"]
                            else {"label": None, "rule": None, "kept": None})} for x in dman.get("items", [])],
              "counts": {"labelled": n_rows, "kept": kept, "dropped": n_rows - kept},
              "label_set_sha256": sha(labels_text.encode()), "rule": RULE,
              "m14_after_veto": {"train_runs": len(train), "train_kept": train_kept,
                                 "kept_run_fraction": train_kept / len(train) if train else None}}
    manifest = {**dman, "format": "avos-retrain-manifest/1+labels", "labels": labels, "m10": quality,
                "judge": {"model": summary["model"], "rubric_sha256": summary["rubric_sha256"],
                          "consistency": summary["judge"]["consistency"]}}
    if a.checklist:
        write_outputs(a.out, {"checklist.jsonl": "".join(json.dumps(v, ensure_ascii=False) + "\n" for v in views.values())})
    write_outputs(a.out, {"labels.jsonl": labels_text,
                          "summary.json": json.dumps(summary, indent=1, ensure_ascii=False) + "\n",
                          "manifest.json": json.dumps(manifest, indent=1, ensure_ascii=False) + "\n",
                          "gold.json": json.dumps(gold, indent=1) + "\n",
                          "CARD.md": card(summary, manifest, labels)})
    print(json.dumps({"out": a.out, "labelled": n_rows, "runs": runs_m, "kept": kept, "dropped": n_rows - kept,
                      "judged": summary["counts"]["judged"], "judge_unknown": unknown, **summary["judge"],
                      **({"checklist": {k: summary["checklist"][k] for k in ("answered", "unanswered", "calls_made", "calls_reused")}}
                         if a.checklist else {}),
                      "stale_labels": len(stale), "invalid_rows": len(invalid), "exit": rc}, ensure_ascii=False))
    if rc:
        problems = [f"{unknown} run(s) without a judge verdict" if unknown else "",
                    f"{len(open_stale)} run(s) with only stale human labels" if open_stale else "", f"{len(invalid)} invalid label row(s)" if invalid else "",
                    f"{hash_bad} item(s) whose content does not match item_id" if hash_bad else ""]
        print("label: " + "; ".join(p for p in problems if p) + f" (see {a.out}/summary.json)", file=sys.stderr)
    return rc


def cmd_view(a):
    it = find_item(dataset_dir(a), a.run)
    if it is None:
        raise Fail(f"{a.run}: not in the dataset", 1)
    text = (f"run={it['run']} principal={it['principal']} task={it['task']} item={it['item_id']}\n"
            f"tools={','.join(t['function']['name'] for t in it['tools'])}\n{render(it)}\n")
    if a.html:
        text = f"<!doctype html>\n<meta charset=\"utf-8\">\n<title>{html.escape(a.run)}</title>\n<pre>\n{html.escape(text)}</pre>\n"
    sys.stdout.write(text)
    return 0


def cmd_human(a):
    it = find_item(dataset_dir(a), a.run)
    if it is None:
        raise Fail(f"{a.run}: not in the dataset", 1)
    name = a.labeller if a.labeller.startswith("human:") else f"human:{a.labeller}"
    if not a.labeller.strip() or "\n" in name:
        raise Fail("--labeller must be a non-empty name", 2)
    note = scrub(a.note, "\x00".join(transcript_strings(it))) if a.note else None
    row = make_row(level=2, content_sha256=content_key(it), item_id=it["item_id"], run=it["run"], labeller=name,
                   ts=now(), verdict=a.verdict, note=note)
    Store(ROOT).append([row])
    print(json.dumps(row, sort_keys=True, ensure_ascii=False))
    return 0


def cmd_gold(a):
    p = os.path.join(a.out, "gold.json")
    if not os.path.isfile(p):
        raise Fail(f"{p}: no gold set (run `label run` first)", 2)
    with open(p, encoding="utf-8") as f:
        gold = json.load(f)
    keys = {}
    lp = os.path.join(a.out, "labels.jsonl")
    if os.path.isfile(lp):
        with open(lp, encoding="utf-8") as f:
            keys = {r["run"]: r["content_sha256"] for r in map(json.loads, filter(str.strip, f))}
    rows, _ = read_root(ROOT)
    done = {(r["run"], r["content_sha256"]) for r in rows.values() if r["level"] == 2}
    labelled = [r for r in gold["runs"] if (r, keys.get(r)) in done] if keys else gold["labelled"]
    left = [r for r in gold["runs"] if r not in labelled]
    if a.next:
        print(left[0] if left else "")
        return 0
    print(json.dumps({"selected": len(gold["runs"]), "labelled": len(labelled), "left": len(left),
                      "strata": {s: {"selected": len(v), "labelled": sum(1 for r in v if r in labelled)}
                                 for s, v in gold["picked"].items()}}))
    return 0


def cmd_checklist(a):
    lp = os.path.join(a.out, "labels.jsonl")
    if not os.path.isfile(lp):
        raise Fail(f"{lp}: no labels (run `label run --checklist` first)", 2)
    with open(lp, encoding="utf-8") as f:
        row = next((r for r in map(json.loads, filter(str.strip, f)) if r["run"] == a.run), None)
    if row is None:
        raise Fail(f"{a.run}: not in {lp}", 1)
    cp = os.path.join(a.out, "checklist.jsonl")
    c = None
    if os.path.isfile(cp):
        with open(cp, encoding="utf-8") as f:
            c = next((x for x in map(json.loads, filter(str.strip, f)) if x["run"] == a.run), None)
    if not c or c["content_sha256"] != row["content_sha256"]:
        raise Fail(f"{a.run}: no checklist (not eligible, or the last `label run` was not given --checklist)", 1)
    stored, _ = read_root(ROOT)
    human = newest([r for r in stored.values()
                    if r["level"] == 2 and (r["run"], r["content_sha256"]) == (a.run, row["content_sha256"])])
    gp = os.path.join(a.out, "gold.json")
    if os.path.isfile(gp):
        with open(gp, encoding="utf-8") as f:
            gold = json.load(f)
        if a.run in gold["runs"] and not human:
            raise Fail(f"{a.run} is in the gold set and has no human label yet: label it blind first (`label view`)", 1)
    if a.json:
        print(json.dumps(c, ensure_ascii=False))
        return 0
    if c["status"] != "answered":
        print(f"{a.run}  checklist: not answered ({c.get('reason', 'unavailable')}; `label run --checklist` asks again)")
        return 0
    with open(CHECKLIST, encoding="utf-8") as f:
        questions = json.load(f)["questions"]
    l0, l1, fin = row["level0"], row["level1"], row["final"]
    out = [f"{a.run}  ({row['task']})", f"checklist  {c['model_version'] or c['model']}  verdict {c['verdict'].upper()}"]
    for q, x in c["answers"].items():
        name = questions.get(q, {}).get("label", q)
        out.append(f"  {name:<34} {x['answer']:<7} p(yes) {x['p']:.2f}  confidence {x['confidence']:.2f}")
    judge = "not judged" if not l1 else f"{l1['verdict']} (framings " + "/".join(
        f["verdict"] for f in l1["framings"].values()) + ")"
    out += ["other layers",
            f"  reward     {'pass' if l0['passed'] else 'fail'} ({l0['reward']}){'' if l0['status'] == 'clean' else ', not clean: ' + ','.join(l0['reasons'])}",
            f"  judge      {judge}",
            f"  human      {human['verdict'] + ' (' + human['labeller'] + ')' if human else 'not labelled'}",
            f"  final      {fin['label']} (rule {fin['rule']}){', kept' if fin['kept'] else ''} as of the last `label run`"]
    print("\n".join(out))
    return 0


def cmd_merge(a):
    have, _ = read_root(ROOT)
    added, skipped, invalid = {}, 0, 0
    for src in a.sources:
        if not os.path.isdir(src):
            raise Fail(f"{src}: not a label root", 2)
        rows, bad = read_root(src)
        invalid += len(bad)
        for lid in sorted(rows):
            if lid in have or lid in added:
                skipped += 1
            else:
                added[lid] = rows[lid]
    Store(ROOT).append([added[k] for k in sorted(added)])
    print(json.dumps({"added": len(added), "skipped": skipped, "invalid": invalid}))
    if invalid:
        print(f"label: {invalid} invalid row(s) in the source root(s) were not merged", file=sys.stderr)
    return 1 if invalid else 0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Fail(message, 2)


def main():
    ap = Parser(prog="label", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=Parser)
    r = sub.add_parser("run")
    r.add_argument("--dataset")
    r.add_argument("--out", required=True)
    r.add_argument("--level", required=True)
    r.add_argument("--run", action="append")
    r.add_argument("--rubric")
    r.add_argument("--gold-n", type=int, default=60)
    r.add_argument("--seed", type=int, default=0)
    r.add_argument("--retry-unknown", action="store_true")
    r.add_argument("--checklist", action="store_true")
    v = sub.add_parser("view")
    v.add_argument("--dataset")
    v.add_argument("--run", required=True)
    v.add_argument("--html", action="store_true")
    h = sub.add_parser("human")
    h.add_argument("--dataset")
    h.add_argument("--run", required=True)
    h.add_argument("--verdict", required=True, choices=("pass", "fail"))
    h.add_argument("--labeller", required=True)
    h.add_argument("--note")
    g = sub.add_parser("gold")
    g.add_argument("--out", required=True)
    which = g.add_mutually_exclusive_group(required=True)
    which.add_argument("--next", action="store_true")
    which.add_argument("--status", action="store_true")
    c = sub.add_parser("checklist")
    c.add_argument("--out", required=True)
    c.add_argument("--run", required=True)
    c.add_argument("--json", action="store_true")
    m = sub.add_parser("merge")
    m.add_argument("--from", dest="sources", action="append", required=True)
    try:
        a = ap.parse_args()
        return {"run": cmd_run, "view": cmd_view, "human": cmd_human, "gold": cmd_gold, "checklist": cmd_checklist,
                "merge": cmd_merge}[a.cmd](a)
    except Fail as e:
        print(f"label: {e}", file=sys.stderr)
        return e.rc
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        print(f"label: {type(e).__name__}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
