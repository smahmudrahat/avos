#!/usr/bin/env python3
"""fleet: run τ² trials at a stated concurrency, one microVM per trial, and compute the matrix from what they left
(POC 10, fleet/CONTRACT.md).

  fleet run --out DIR (--tasks T,... | --part train) --trials N --concurrency C   resumable; SIGTERM stops cleanly
  fleet matrix --fleet DIR --prices PRICES.json [--labels PATH] [--json] [--out FILE]   M2 M8 M11 M12 M13 M16
  fleet sweep --out DIR --levels 1,2,... --tasks ... --trials N                   one fleet per level, then m17
  fleet m17 DIR [--json]                                                          M17 from DIR/level_*/
  fleet compare --a MATRIX_A.json --b MATRIX_B.json [--seed 300] [--json] [--out FILE]   B − A, paired by task
  fleet m15 --retrained MATRIX.json [...] --closed MATRIX.json [...] [--base-root ROOT] [--assert-served FLEET=retrained]
            [--seed 300] [--bar-x 0.75] [--bar-y 5] [--json]
                                                                                  X, Y: sessions pooled per task

Every trial is one `infra/job run tau2 retail/<task>` with its own SLOT; infra/job claims the run id, the runner
finds it afterwards by the job.json naming the slot. DIR holds fleet.json, the journal (trials.jsonl, one line per
trial end) and the run ids that predate it (preexisting.json); the matrix reads DIR, the run directories and the
prices file only. No cache: every number is recomputed from the files on each call.
"""
import argparse
import calendar
import fcntl
import hashlib
import json
import math
import os
import random
import re
import signal
import statistics
import subprocess
import sys
import time
import urllib.error
import urllib.request
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
AVOS = os.path.join(REPO, "collect", "bin", "avos")
JAIL = "/var/lib/avos/jail/firecracker"
SPLIT = "data/splits/retail_user_disjoint_v1.json"
ROLES = {"policy": "Qwen/Qwen3-30B-A3B-Instruct-2507", "simulator": "google/gemma-3-27b-it",
         "nl_judge": "deepseek-ai/DeepSeek-V4-Flash-0731"}
INFRA_REASONS = ("user_error", "timeout", "infrastructure_error", "unexpected_error")
AGENT_REASONS = ("agent_error", "too_many_errors", "context_window_exceeded", "max_steps", "agent_stop", "user_stop")
AGENT_CLASS = {"unknown", "gateway_timeout", "gateway_5xx_unattributed", "agent_empty_reply", "agent_timeout"}
STALL_MS = 300_000
EMPTY_REPLY = "AssistantMessage must have either content or tool_calls"
U = "unverified"
RULE = "median host-side trial time ≤ 1.05 × lowest level"
ROUTES = os.environ.get("AVOS_GATEWAY_ROUTES") or "/var/lib/avos/gateway.routes.json"
USAGE = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens", "thinking_tokens")
CLOSED = ("claude-", "anthropic/")  # closed-weight model names (eval/CONTRACT.md §4); grows only with a dated reason there


class Fail(Exception):
    def __init__(self, msg, code=2):
        super().__init__(msg)
        self.code = code


# ---------------------------------------------------------------- files

def ts(t=None):
    t = time.time() if t is None else t
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + f".{int(t * 1000) % 1000:03d}Z"


def parse_ts(s):
    return calendar.timegm(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")) * 1000 + int(s[20:23])


def sha_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def load(path, what):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        raise Fail(f"{what} unreadable: {path}: {e}")


def jsonl(path, what):
    try:
        with open(path, encoding="utf-8") as f:
            return [json.loads(l) for l in f if l.strip()]
    except (OSError, ValueError) as e:
        raise Fail(f"{what} unreadable: {path}: {e}")


def write_atomic(path, obj):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def read_job(d):
    try:
        with open(os.path.join(d, "job.json"), encoding="utf-8") as f:
            j = json.load(f)
        return j if isinstance(j, dict) else None
    except (OSError, ValueError):
        return None


def task_of(run):
    """run_retail-<task>_<trial> -> task, else None."""
    if not run.startswith("run_retail-") or "_" not in run[11:]:
        return None
    return run[11:].rsplit("_", 1)[0]


# ---------------------------------------------------------------- run

def policy_route(model, first_slot):
    """The policy's entry in the gateway's route table as `gateway.py route` picks it for the first slot: kind,
    upstream (url, or every url of a list) and, for anthropic, the pinned settings. Never the key."""
    if not os.path.exists(ROUTES):
        return {"kind": "openai", "upstream": None, "served": None}
    table = load(ROUTES, "gateway route table")
    ups = table.get(model) if isinstance(table, dict) else None
    if ups is None:
        return {"kind": "openai", "upstream": None, "served": None}
    ups = [{"base_url": u} if isinstance(u, str) else u for u in (ups if isinstance(ups, list) else [ups])]
    if not ups or not all(isinstance(u, dict) for u in ups):
        raise Fail(f"{ROUTES}: the route of {model} is not a url or an object")
    pick = ups[int(first_slot[3:]) % len(ups)]
    urls = [u.get("base_url") for u in ups]
    r = {"kind": pick.get("kind", "openai"), "upstream": urls[0] if len(urls) == 1 else urls}
    if r["kind"] != "openai":
        r.update({k: pick.get(k) for k in ("effort", "max_tokens", "cache")})
    else:
        r["served"] = [served(u.get("base_url"), model, u.get("key")) for u in ups]
        if len({x["root"] for x in r["served"]}) > 1:
            raise Fail(f"policy_unverified: the upstreams of {model} report different checkpoints: "
                       + ", ".join(f"{x['upstream']} {x['root']}" for x in r["served"]), 1)
    return r


def bearer(url, var):
    """The upstream's key, read as the gateway reads it (the variable `key` names in gateway.env); never printed."""
    if not var:
        return {}
    env = os.environ.get("AVOS_GATEWAY_ENV") or "/var/lib/avos/gateway.env"
    try:
        with open(env, encoding="utf-8") as f:
            vals = dict(l.split("=", 1) for l in f.read().splitlines() if "=" in l)
    except OSError:
        raise Fail(f"policy_unverified: {url}: the gateway env file {env} is unreadable (run as root)", 1)
    if not vals.get(var):
        raise Fail(f"policy_unverified: {url}: the gateway env file {env} lacks this upstream's key variable", 1)
    return {"Authorization": f"Bearer {vals[var]}"}


def served(base, model, var=None):
    """Which checkpoint an OpenAI-compatible (vLLM) upstream serves under the policy's name: its GET /models `root`,
    asked with the upstream's key as the gateway sends it."""
    url = str(base).rstrip("/") + "/models"
    req = urllib.request.Request(url, headers=bearer(url, var))
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            data = json.loads(r.read()).get("data")
        entry = next((m for m in data if isinstance(m, dict) and m.get("id") == model), None)
    except urllib.error.HTTPError as e:
        raise Fail(f"policy_unverified: {url}: HTTP {e.code}" + (" (the key was refused or not sent)" if e.code in (401, 403) else ""), 1)
    except (OSError, ValueError, AttributeError, TypeError) as e:
        raise Fail(f"policy_unverified: {url}: {type(e).__name__}: {e}", 1)
    root = (entry or {}).get("root")
    if entry is None or not (root is None or isinstance(root, str)):
        raise Fail(f"policy_unverified: {url} serves no {model} (models: "
                   + ", ".join(str(m.get("id")) for m in data if isinstance(m, dict)) + ")", 1)
    return {"upstream": base, "id": model, "root": root}  # root null: a hosted provider names no checkpoint


def closed(model):
    return isinstance(model, str) and model.startswith(CLOSED)


def split_tasks(path, part, tasks):
    p = path if os.path.exists(path) else os.path.join(REPO, path)
    split = load(p, "split")
    allowed = [str(t) for t in split.get(part, [])]
    want = allowed if tasks is None else [t.strip() for t in tasks.split(",")]
    bad = [t for t in want if t not in allowed]
    if bad:
        raise Fail(f"tasks not in the {part} part of {path}: {','.join(bad)} (refused; nothing run)")
    if len(set(want)) != len(want) or not want:
        raise Fail(f"--tasks must name distinct tasks: {tasks}")
    return want, sha_file(p)


class Runner:
    def __init__(self, a, out, concurrency, name):
        self.a, self.out, self.conc = a, os.path.abspath(out), concurrency
        self.tasks, sha = split_tasks(a.split, a.part, a.tasks)
        roles = {"policy": a.policy, "simulator": a.simulator, "nl_judge": a.judge}
        if len(set(roles.values())) != 3:
            raise Fail(f"roles must be three distinct models: {roles}")
        if a.trials < 1 or concurrency < 1 or concurrency > 254:
            raise Fail("--trials ≥ 1 and 1 ≤ --concurrency ≤ 254")
        m = re.fullmatch(r"vm-(\d{2,3})-vm-(\d{2,3})", a.slots or f"vm-01-vm-{concurrency:02d}")
        lo, hi = (int(m[1]), int(m[2])) if m else (0, -1)
        if not 1 <= lo <= hi <= 254 or hi - lo + 1 < concurrency:
            raise Fail(f"--slots {a.slots} must be vm-NN-vm-MM within vm-01…vm-254 holding ≥ {concurrency} slots")
        slots = [f"vm-{n:02d}" for n in range(lo, hi + 1)]
        self.results = os.path.abspath(a.results or os.environ.get("AVOS_FLEET_RESULTS") or "/var/lib/avos/results")
        self.job = os.path.abspath(a.job or os.path.join(REPO, "infra", "job"))
        self.meta_path = os.path.join(self.out, "fleet.json")
        self.plan = {"fleet": name or os.path.basename(self.out), "harness": "tau2", "domain": "retail",
                     "tasks": self.tasks, "trials_per_task": a.trials, "concurrency": concurrency, "mem_mib": a.mem_mib, "slots": slots,
                     "split": {"path": a.split, "sha256": sha, "part": a.part}, "roles": roles,
                     "results_root": self.results, "policy_route": policy_route(a.policy, slots[0])}
        if a.agent_temperature or a.agent_top_p is not None:
            if not 0 <= a.agent_temperature <= 2 or not 0 < (a.agent_top_p if a.agent_top_p is not None else 1) <= 1:
                raise Fail("0 ≤ --agent-temperature ≤ 2 and 0 < --agent-top-p ≤ 1")
            self.plan["agent_sampling"] = {"temperature": a.agent_temperature, "top_p": a.agent_top_p}
        self.stopping = None

    def check_resume(self, meta):
        for k in ("tasks", "trials_per_task", "concurrency", "slots", "split", "roles", "results_root", "agent_sampling",
                  "policy_route"):
            if meta.get(k) != self.plan.get(k):
                raise Fail(f"{self.out} is a fleet with {k}={json.dumps(meta.get(k))}, not {json.dumps(self.plan.get(k))}")

    def task_dirs(self):
        want = set(self.tasks)
        try:
            return {n for n in os.listdir(self.results) if task_of(n) in want}
        except OSError as e:
            raise Fail(f"results root unreadable: {e}", 1)

    def save(self):
        write_atomic(self.meta_path, self.meta)

    def journal(self, run, task, slot, status, interrupted, started, ended):
        line = {"task": task, "run": run, "slot": slot, "status": status, "interrupted": interrupted,
                "started": started, "ended": ended}
        with open(os.path.join(self.out, "trials.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(line, sort_keys=True) + "\n")
            f.flush()
            os.fsync(f.fileno())
        self.lines.append(line)
        self.known.add(run)
        print(f"{ended} {run} {slot} {status}{' (interrupted)' if interrupted else ''}", file=sys.stderr, flush=True)

    def completeness(self, run):
        d = os.path.join(self.results, run)
        try:
            p = subprocess.run([sys.executable, AVOS, "completeness", "--run", run], capture_output=True, text=True,
                               timeout=300)
            rec = json.loads(p.stdout) if p.returncode == 0 else None
        except (OSError, ValueError, subprocess.TimeoutExpired):
            rec = None
        if not isinstance(rec, dict) or "status" not in rec:
            rec = {"run": run, "status": U, "ratio": None, "error": "avos completeness gave no record"}
        write_atomic(os.path.join(d, "completeness.json"), rec)

    def record(self, run, task, slot, started, signaled):
        """Journal one ended trial from its job.json (writing an aborted one when the job left none)."""
        d = os.path.join(self.results, run)
        job = read_job(d)
        if job is None or job.get("status") not in ("done", "failed", "aborted"):
            job = {"run": run, "task": f"retail/{task}", "status": "aborted", "stage": "unknown", "exit_code": -1}
            write_atomic(os.path.join(d, "job.json"), job)
            signaled = True
        interrupted = signaled and job["status"] == "aborted"
        if not interrupted:
            self.completeness(run)
        self.journal(run, task, slot or job.get("vm"), job["status"], interrupted, started or ts(), ts())

    def adopt(self):
        """Every run directory of the fleet's tasks that is neither preexisting nor journaled: journal it as it is."""
        for run in sorted(self.task_dirs() - self.pre - self.known):
            self.record(run, task_of(run), None, None, False)

    def remaining(self):
        have = Counter(l["task"] for l in self.lines if not l["interrupted"])
        left = {t: self.plan["trials_per_task"] - have[t] for t in self.tasks}
        queue = []
        for i in range(max(left.values(), default=0)):
            queue += [t for t in self.tasks if left[t] > i]
        return queue

    def summary(self, t0):
        live = [l for l in self.lines if not l["interrupted"]]
        c = Counter(l["status"] for l in live)
        return {"fleet": self.meta["fleet"], "planned": len(self.tasks) * self.plan["trials_per_task"],
                "done": c["done"], "failed": c["failed"], "aborted": c["aborted"],
                "interrupted": len(self.lines) - len(live), "status": self.meta["status"],
                "wall_s": round(time.time() - t0, 1)}

    def complete(self):
        live = [l for l in self.lines if not l["interrupted"]]
        per = Counter(l["task"] for l in live)
        return (all(per[t] == self.plan["trials_per_task"] for t in self.tasks) and len({l["run"] for l in live}) == len(live)
                and all(os.path.exists(os.path.join(self.results, l["run"], "job.json")) for l in live))

    def run(self):
        t0 = time.time()
        os.makedirs(self.out, exist_ok=True)
        self.lockf = open(os.path.join(self.out, ".lock"), "w")
        try:
            fcntl.flock(self.lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Fail(f"{self.out} is in use (a runner or the jobs of a killed one are still running)", 1)
        jpath = os.path.join(self.out, "trials.jsonl")
        if os.path.exists(self.meta_path):
            self.meta = load(self.meta_path, "fleet.json")
            self.check_resume(self.meta)
            self.lines = jsonl(jpath, "journal") if os.path.exists(jpath) else []
            self.pre = set(load(os.path.join(self.out, "preexisting.json"), "preexisting.json"))
        else:
            if not os.path.isdir(self.results):
                raise Fail(f"results root {self.results} does not exist")
            self.pre, self.lines = self.task_dirs(), []
            write_atomic(os.path.join(self.out, "preexisting.json"), sorted(self.pre))
            open(jpath, "a").close()
            self.meta = {**self.plan, "sessions": [], "status": "running", "peak_guest_mem_mib": None}
        self.known = {l["run"] for l in self.lines}
        if self.meta["status"] == "done" and self.complete():
            return self.summary(t0)
        s = self.meta["sessions"]
        if s and s[-1]["ended"] is None:
            ends = [l["ended"] for l in self.lines]
            s[-1]["ended"] = max(ends) if ends else s[-1]["started"]
        s.append({"started": ts(t0), "ended": None, "pid": os.getpid()})
        self.meta["status"] = "running"
        self.save()
        self.adopt()
        self.loop()
        if not self.stopping and not STOP:
            self.adopt()
        self.meta["status"] = "done" if self.complete() else "stopped"
        s[-1]["ended"] = ts()
        self.save()
        if self.stopping and self.stopping != "signal":
            print(f"fleet: stopped: {self.stopping}", file=sys.stderr)
        return self.summary(t0)

    def launch(self, slot, task):
        env = {**os.environ, "SLOT": slot, "MEM_MIB": str(self.plan["mem_mib"]), "MODEL": self.plan["roles"]["policy"],
               "USER_MODEL": self.plan["roles"]["simulator"], "JUDGE_MODEL": self.plan["roles"]["nl_judge"],
               **{f"AGENT_{k.upper()}": str(v) for k, v in self.plan.get("agent_sampling", {}).items() if v is not None},
               "AVOS_RESULTS": self.results, "AVOS_FLEET_RESULTS": self.results}
        with open(os.path.join(self.out, "jobs.log"), "ab") as log:
            p = subprocess.Popen([self.job, "run", "tau2", f"retail/{task}"], env=env, stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=log, start_new_session=True, pass_fds=(self.lockf.fileno(),))
        return {"p": p, "task": task, "started": ts(), "signaled": None}

    def finish(self, slot, j):
        mine = [r for r in sorted(self.task_dirs() - self.pre - self.known)
                if task_of(r) == j["task"] and (read_job(os.path.join(self.results, r)) or {}).get("vm") == slot]
        if len(mine) != 1:
            self.stopping = self.stopping or f"the job of task {j['task']} on {slot} left no job.json naming its slot; resume adopts its directory"
            return
        self.record(mine[0], j["task"], slot, j["started"], j["signaled"] is not None)

    def peak(self, slots):
        total = 0
        for s in slots:
            try:
                pid = open(f"{JAIL}/{s}/pid").read().strip()
                total += next(int(l.split()[1]) for l in open(f"/proc/{pid}/status") if l.startswith("VmRSS:")) / 1024
            except (OSError, ValueError, StopIteration):
                pass
        if total:
            self.meta["peak_guest_mem_mib"] = max(self.meta["peak_guest_mem_mib"] or 0, round(total, 1))

    def loop(self):
        queue = self.remaining()
        free = self.plan["slots"][::-1]
        live = {}
        while (queue and not self.stopping) or live:
            if STOP and not self.stopping:
                self.stopping = "signal"
            while queue and free and len(live) < self.conc and not self.stopping:
                slot = free.pop()
                live[slot] = self.launch(slot, queue.pop(0))
            self.peak(live)
            for slot, j in list(live.items()):
                if j["p"].poll() is not None:
                    del live[slot]
                    self.finish(slot, j)
                    free.append(slot)
                    free.sort(reverse=True)
            if self.stopping:
                for slot, j in live.items():
                    if j["signaled"] is None:
                        j["signaled"] = time.time()
                        killpg(j["p"].pid, signal.SIGTERM)
                    elif time.time() - j["signaled"] > 45 and j["p"].poll() is None:
                        killpg(j["p"].pid, signal.SIGKILL)  # a job deaf to SIGTERM: kill it, destroy its VM here
                        j["p"].wait()
                        vm = os.path.join(os.path.dirname(self.job), "vm")
                        if os.path.exists(vm):
                            subprocess.run([vm, "destroy", slot], capture_output=True, timeout=60)
            time.sleep(0.2)


STOP = []


def killpg(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except ProcessLookupError:
        pass


def do_run(a, out=None, concurrency=None, name=None):
    signal.signal(signal.SIGTERM, lambda *_: STOP.append(1))
    signal.signal(signal.SIGINT, lambda *_: STOP.append(1))
    return Runner(a, out or a.out, concurrency or a.concurrency, name or a.name).run()


def cmd_run(a):
    summ = do_run(a)
    print(json.dumps(summ, sort_keys=True) if a.json else
          f"{summ['fleet']}: {summ['done']} done, {summ['failed']} failed, {summ['aborted']} aborted of {summ['planned']} "
          f"({summ['interrupted']} interrupted), {summ['status']}, {summ['wall_s']} s")
    return 0 if summ["status"] == "done" else 1


def cmd_sweep(a):
    try:
        levels = sorted({int(x) for x in a.levels.split(",")})
    except ValueError:
        raise Fail(f"--levels must be integers: {a.levels}")
    os.makedirs(a.out, exist_ok=True)
    for L in levels:
        summ = do_run(a, os.path.join(a.out, f"level_{L}"), L, f"level_{L}")
        print(f"level {L}: {summ['done']}/{summ['planned']} done, {summ['status']}", file=sys.stderr, flush=True)
        if summ["status"] != "done" or STOP:
            return 1
    return emit_m17(a.out, a.json)


# ---------------------------------------------------------------- per-trial facts (§4, §5)

def read_events(path):
    """-> rows, or None when missing or a line is not a JSON object."""
    rows = []
    try:
        with open(path, "rb") as f:
            for raw in f:
                if raw.strip():
                    ev = json.loads(raw)
                    if not isinstance(ev, dict):
                        return None
                    rows.append(ev)
    except (OSError, ValueError):
        return None
    return rows


def role_mismatch(rows, roles):
    """The VM's model calls are not the fleet's roles: a 200 from another model, or none from the policy."""
    if not any(e.get("kind") == "llm.call" for e in rows):
        return False
    ok = {str(e.get("model")) for e in rows if e.get("kind") == "llm.call" and e.get("status") == 200}
    return bool(ok - set(roles.values())) or roles["policy"] not in ok


def witness_mismatch(d, rows, roles):
    """result.json is not one simulation whose usage-bearing messages are, in order and in tokens, the trial's
    status-200 policy and simulator calls: τ² retried the simulation, or the witness was edited."""
    try:
        with open(os.path.join(d, "result.json"), encoding="utf-8") as f:
            sims = json.load(f).get("simulations")
    except (OSError, ValueError, AttributeError):
        return False
    if not isinstance(sims, list):
        return False
    if len(sims) != 1:
        return True
    msgs = sims[0].get("messages") if isinstance(sims[0], dict) else None
    if not isinstance(msgs, list) or rows is None:
        return False
    w = [(m["usage"].get("prompt_tokens"), m["usage"].get("completion_tokens")) for m in msgs
         if isinstance(m, dict) and isinstance(m.get("usage"), dict)]
    g = [(e.get("prompt_tokens"), e.get("completion_tokens")) for e in rows
         if e.get("kind") == "llm.call" and e.get("status") == 200 and e.get("model") != roles.get("nl_judge")]
    return w != g


def empty_reply(job, d, rows, roles):
    """τ² called the agent's own unusable reply (no content, no tool calls) an infrastructure_error: its error names
    the AssistantMessage, and the last policy call was a clean 200 (or there is no policy row)."""
    if job.get("termination_reason") != "infrastructure_error":
        return False
    text = str(job.get("error") or "")
    try:
        with open(os.path.join(d, "result.json"), encoding="utf-8") as f:
            text += " " + str(json.load(f)["simulations"][0].get("info", {}).get("error") or "")
    except (OSError, ValueError, KeyError, IndexError, TypeError, AttributeError):
        pass
    if EMPTY_REPLY not in text:
        return False
    pol = [e for e in rows or [] if e.get("kind") == "llm.call" and e.get("model") == roles["policy"]]
    return not pol or (pol[-1].get("status") == 200 and pol[-1].get("upstream_status", 200) == 200 and not pol[-1].get("error"))


def upstream_stalled(rows, roles):
    """A timed-out trial is infra only when the policy stalled: no successful policy call in its last 300 s."""
    ok = [e for e in rows or [] if e.get("kind") == "llm.call" and e.get("model") == roles["policy"] and e.get("status") == 200]
    if not ok:
        return True
    end = next((e["ts"] for e in rows if e.get("kind") == "session.close"), None) or max(e["ts"] for e in rows)
    return parse_ts(end) - parse_ts(ok[-1]["ts"]) >= STALL_MS


def cause_of(status, job, rows, roles, d):
    if status == "missing":
        return "no_job_json"
    if rows is not None and status != "done":
        denies = [e for e in rows if e.get("kind") == "authz.decision" and e.get("decision") == "deny"]
        if any("no-route" in (e.get("policy_ids") or []) for e in denies):
            return "model_unrouted"
        if denies:
            return "authz_denied"
        calls = [e for e in rows if e.get("kind") == "llm.call" and isinstance(e.get("status"), int)]
        five = [e for e in calls if e["status"] >= 500]
        if any(isinstance(e.get("upstream_status"), int) and e["upstream_status"] >= 500 for e in five):
            return "upstream_5xx"
        if any(e.get("upstream_status") is None and str(e.get("error") or "").startswith("upstream_unreachable") for e in five):
            return "upstream_unreachable"
        if any(e.get("error") == "gateway_timeout" for e in five):
            return "gateway_timeout"
        if five:
            return "gateway_5xx_unattributed"
        if any(400 <= e["status"] < 500 for e in calls):
            return "upstream_4xx"
    if rows is not None and role_mismatch(rows, roles):
        return "role_mismatch"
    if status == "failed" and empty_reply(job, d, rows, roles):
        return "agent_empty_reply"
    if status == "done" and witness_mismatch(d, rows, roles):
        return "witness_mismatch"
    if status == "done":
        return None
    if rows is not None and any(e.get("kind") == "llm.call" and e.get("status") == 200 and e.get("finish_reason") == "length"
                                and e.get("model") == roles["policy"] for e in rows):
        return "agent_length"
    if status == "aborted":
        return {"create": "vm_create_failed", "session": "session_open_failed"}.get(job.get("stage"), "harness_aborted")
    http = job.get("http")
    if http == "timeout":
        return "harness_timeout" if upstream_stalled(rows, roles) else "agent_timeout"
    if http is not None and str(http) != "200":
        return "harness_http_error"
    tr = job.get("termination_reason")
    if tr in INFRA_REASONS:
        return f"sim_{tr}"
    if tr in AGENT_REASONS:
        return f"agent_{tr}"
    return "unknown"


def trial(results, run, task, slot, roles):
    d = os.path.join(results, run)
    job = read_job(d)
    status = job["status"] if job and job.get("status") in ("done", "failed", "aborted") else "missing"
    rows = read_events(os.path.join(d, "events.jsonl"))
    llm = U
    if rows is not None:
        by, total, calls = {}, 0, 0
        for e in rows:
            if e.get("kind") != "llm.call":
                continue
            b = by.setdefault(str(e.get("model")), {"calls": 0, "ok": 0, "prompt_tokens": 0, "completion_tokens": 0, "ms": 0})
            ms = e.get("ms") if isinstance(e.get("ms"), (int, float)) else 0
            b["calls"] += 1
            b["ms"] += ms
            calls += 1
            total += ms
            if e.get("status") == 200:
                b["ok"] += 1
                b["prompt_tokens"] += e.get("prompt_tokens") or 0
                b["completion_tokens"] += e.get("completion_tokens") or 0
        llm = {"calls": calls, "ms": total, "by_model": by}
    cause = cause_of(status, job, rows, roles, d)
    cls = None if cause is None else ("agent" if cause.startswith("agent_") or cause in AGENT_CLASS else "infra")
    wall = job.get("wall_ms") if job and isinstance(job.get("wall_ms"), int) else None
    reward = job.get("reward") if job and isinstance(job.get("reward"), (int, float)) else None
    m8 = U
    try:
        with open(os.path.join(d, "completeness.json"), encoding="utf-8") as f:
            c = json.load(f)
        if c.get("status") in ("complete", "incomplete") and isinstance(c.get("ratio"), (int, float)):
            m8 = {"status": "witness_mismatch" if cause == "witness_mismatch" else c["status"], "ratio": float(c["ratio"])}
    except (OSError, ValueError, AttributeError):
        pass
    return {"run": run, "task": task, "slot": slot, "status": status, "reward": reward,
            "termination_reason": job.get("termination_reason") if job else None, "wall_ms": wall,
            "cause": cause, "cause_class": cls, "valid": cause is None or cls == "agent",
            "passed": (reward == 1.0) if status == "done" and cause is None else None, "llm": llm,
            "host_side_ms": wall - llm["ms"] if wall is not None and llm != U else U, "m8": m8}


def fleet_meta(fdir):
    meta = load(os.path.join(fdir, "fleet.json"), "fleet.json")
    lines = jsonl(os.path.join(fdir, "trials.jsonl"), "journal")
    if not isinstance(meta, dict) or not all(isinstance(l, dict) for l in lines):
        raise Fail(f"{fdir}: fleet.json or trials.jsonl is not the contract's shape")
    roles = meta.get("roles")
    if not isinstance(roles, dict) or len({roles.get(r) for r in ("policy", "simulator", "nl_judge")}) != 3 or \
            not all(isinstance(roles.get(r), str) for r in ("policy", "simulator", "nl_judge")):
        raise Fail(f"{fdir}: roles are not three distinct model names: {roles}")
    return meta, lines


# ---------------------------------------------------------------- matrix (§4)

def num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def pass_k(c, n, k):
    return None if n < k else math.comb(c, k) / math.comb(n, k)


def ci95(vals, seed=300):
    T = len(vals)
    if T < 2:
        return U
    rng = random.Random(seed)
    means = sorted(statistics.fmean([vals[rng.randrange(T)] for _ in range(T)]) for _ in range(2000))
    return [means[50], means[1949]]


def wall_h(meta, lines):
    ends = [parse_ts(l["ended"]) for l in lines if l.get("ended")]
    total = 0
    for s in meta.get("sessions") or []:
        b = parse_ts(s["ended"]) if s.get("ended") else (max(ends) if ends else None)
        if b is not None:
            total += max(0, b - parse_ts(s["started"]))
    return total / 3_600_000 if meta.get("sessions") else None


def usd(u, p):
    """One row's (or one trial's) bill at list price with the cache rates; U without them."""
    if not isinstance(p, dict) or not all(num(p.get(k)) for k in ("prompt_per_mtok", "completion_per_mtok", "cache_write_per_mtok",
                                                                  "cache_read_per_mtok")):
        return U
    return (u["input_tokens"] * p["prompt_per_mtok"] + u["cache_creation_input_tokens"] * p["cache_write_per_mtok"]
            + u["cache_read_input_tokens"] * p["cache_read_per_mtok"] + u["output_tokens"] * p["completion_per_mtok"]) / 1e6


def billed_trials(results, trials, roles, pr, price):
    """A token-priced (closed) policy: every 200 policy row must carry the fleet's pinned effort and max_tokens and the
    five usage counts, and every trial that called a model must have been answered by the policy and no outsider;
    otherwise the whole matrix is refused. Each trial's policy entry gains its usage sums and its bill."""
    pol = roles["policy"]
    for t in trials:
        if t["llm"] == U:
            continue
        rows = read_events(os.path.join(results, t["run"], "events.jsonl")) or []
        calls = [e for e in rows if e.get("kind") == "llm.call"]
        sums, missing = dict.fromkeys(USAGE, 0), 0
        for e in calls:
            if e.get("model") != pol or e.get("status") != 200:
                continue
            for k, why in (("effort", "effort_mismatch"), ("max_tokens", "max_tokens_mismatch")):
                if e.get(k) != pr.get(k):
                    raise Fail(f"{why}: run {t['run']}: llm.call {e.get('event_id')} has {k} {json.dumps(e.get(k))}, "
                               f"fleet.json pins {json.dumps(pr.get(k))}", 1)
            u = e.get("usage")
            if not isinstance(u, dict) or not all(type(u.get(k)) is int for k in USAGE[:4]) \
                    or u.get("thinking_tokens") is not None and type(u["thinking_tokens"]) is not int:
                raise Fail(f"usage_missing: run {t['run']}: llm.call {e.get('event_id')} usage {json.dumps(u)}", 1)
            for k in USAGE[:4]:
                sums[k] += u[k]
            if u.get("thinking_tokens") is None:
                missing += 1
            else:
                sums["thinking_tokens"] += u["thinking_tokens"]
        ok = {str(e.get("model")) for e in calls if e.get("status") == 200}
        if calls and (pol not in ok or ok - set(roles.values())):
            other = sorted(ok - set(roles.values()))
            raise Fail(f"policy_mismatch: run {t['run']}: model {other[0] if other else None} "
                       f"({'answered instead of' if other else 'no 200 from'} the policy {pol})", 1)
        b = t["llm"]["by_model"].setdefault(pol, {"calls": 0, "ok": 0, "prompt_tokens": 0, "completion_tokens": 0, "ms": 0})
        b["usage"], b["usd"], b["thinking_tokens_missing"] = sums, usd(sums, price), missing


def token_policy(m, a, trials, p, ntr, pass1):
    """M12 of a token-priced policy from its rows' usage and the dated list prices; the uncached ceiling prices every
    prompt token at the input rate."""
    sums, bills, missing = dict.fromkeys(USAGE, 0), [], 0
    for t in trials:
        b = t["llm"]["by_model"].get(m) if t["llm"] != U else None
        if b:
            sums = {k: sums[k] + b["usage"][k] for k in USAGE}
            bills.append(b["usd"])
            missing += b["thinking_tokens_missing"]
    plain = isinstance(p, dict) and all(num(p.get(k)) for k in ("prompt_per_mtok", "completion_per_mtok"))
    total = U if not plain or U in bills else sum(bills)
    pt = total / ntr if total != U and ntr else U
    ceiling = (a["prompt_tokens"] * p["prompt_per_mtok"] + a["completion_tokens"] * p["completion_per_mtok"]) / 1e6 / ntr \
        if plain and ntr else U
    return {"model": m, "source": "gateway", "outside_gateway": False, **a, "usage": sums, "thinking_tokens_missing": missing, "usd_total": total,
            "usd_per_task": pt, "usd_per_successful_task": pt / pass1 if pt != U and pass1 != U and pass1 > 0 else U,
            "basis": "tokens", "uncached_ceiling_usd_per_task": ceiling, "token_ceiling_usd_per_task": ceiling, "price": p}


def matrix(fdir, prices_path, labels=None):
    meta, lines = fleet_meta(fdir)
    prices = load(prices_path, "prices")
    if not isinstance(prices, dict):
        raise Fail(f"prices file is not a JSON object: {prices_path}")
    roles = meta["roles"]
    seen, trials, warnings = set(), [], []
    for ln in lines:
        if ln.get("interrupted"):
            continue
        if ln["run"] in seen:
            warnings.append(f"duplicate journal line for {ln['run']}")
            continue
        seen.add(ln["run"])
        trials.append(trial(meta["results_root"], ln["run"], str(ln["task"]), ln.get("slot"), roles))
        if trials[-1]["status"] == "missing":
            warnings.append(f"{ln['run']}: no job.json (counted as a trial, cause no_job_json)")
    trials.sort(key=lambda t: t["run"])
    pr = meta.get("policy_route")
    if pr is None and closed(roles["policy"]):
        raise Fail(f"{fdir}: fleet.json of closed policy {roles['policy']} has no policy_route")
    tokens = isinstance(pr, dict) and pr.get("kind") == "anthropic"
    models = prices.get("models") if isinstance(prices.get("models"), dict) else {}
    pm = models.get(roles["policy"])
    if tokens:
        billed_trials(meta["results_root"], trials, roles, pr, pm)
    ntr = len(trials)
    done = [t for t in trials if t["status"] == "done"]
    m2 = {"done": len(done), "trials": ntr, "value": len(done) / ntr if ntr else U}
    ver = [t["m8"] for t in trials if t["m8"] != U]
    m8 = {"complete": sum(v["status"] == "complete" for v in ver), "incomplete": sum(v["status"] != "complete" for v in ver),
          "unverified": ntr - len(ver), "mean_ratio": statistics.fmean(v["ratio"] for v in ver) if ver else U}

    per_task = []
    for task in meta["tasks"]:
        ts_ = [t for t in trials if t["task"] == str(task)]
        valid = [t for t in ts_ if t["valid"]]
        n, c = len(valid), sum(1 for t in valid if t["passed"])
        per_task.append({"task": str(task), "n": n, "c": c, "infra": sum(t["cause_class"] == "infra" for t in ts_),
                         "trials": len(ts_), "pass1": pass_k(c, n, 1), "pass4": pass_k(c, n, 4),
                         "avg4": statistics.fmean((t["reward"] or 0.0) for t in valid) if n else None})
    m11 = {"tasks": per_task, "infra_excluded": sum(p["infra"] for p in per_task),
           "tasks_short_4": [p["task"] for p in per_task if p["pass4"] is None and p["trials"]],
           "tasks_all_infra": [p["task"] for p in per_task if p["n"] == 0 and p["trials"]]}
    for key in ("pass1", "pass4", "avg4"):
        vals = [p[key] for p in per_task if p[key] is not None]
        m11[key] = statistics.fmean(vals) if vals else U
        m11[key + "_ci95"] = ci95(vals) if vals else U
    m11["causes"] = dict(sorted(Counter(t["cause"] for t in trials if t["cause"]).items()))
    m11["by_class"] = {k: sum(t["cause_class"] == k for t in trials) for k in ("agent", "infra")}

    hosts = prices.get("hosts") if isinstance(prices.get("hosts"), dict) else {}
    wh = wall_h(meta, lines)
    pass1 = m11["pass1"]
    agg = {}
    for t in trials:
        if t["llm"] != U:
            for m, b in t["llm"]["by_model"].items():
                a = agg.setdefault(m, {"calls": 0, "ok": 0, "prompt_tokens": 0, "completion_tokens": 0})
                for k in a:
                    a[k] += b[k]

    def price(m, pt, ct, calls=None):
        if calls == 0:
            return 0.0
        p = models.get(m)
        if not isinstance(p, dict) or not all(num(p.get(k)) for k in ("prompt_per_mtok", "completion_per_mtok")):
            return U
        return (pt * p["prompt_per_mtok"] + ct * p["completion_per_mtok"]) / 1e6

    def per_task_cost(total):
        if total == U or not ntr:
            return U, U
        pt = total / ntr
        return pt, (pt / pass1 if pass1 != U and pass1 > 0 else U)

    m12 = {}
    zero = {"calls": 0, "ok": 0, "prompt_tokens": 0, "completion_tokens": 0}
    for role in ("policy", "simulator", "nl_judge"):
        m = roles[role]
        a = agg.get(m, zero)
        tok = price(m, a["prompt_tokens"], a["completion_tokens"], a["calls"])
        if role == "policy" and tokens:
            m12[role] = token_policy(m, a, trials, pm, ntr, pass1)
            continue
        if role == "policy":
            g = hosts.get("gpu") if isinstance(hosts.get("gpu"), dict) else {}
            cnt = g.get("count", 1)
            ok = num(g.get("usd_per_h")) and isinstance(cnt, int) and not isinstance(cnt, bool) and cnt >= 1
            gpu = {"name": g.get("name", U), "usd_per_h": g["usd_per_h"] if ok else U, "count": cnt if ok else U,
                   "usd_per_h_total": g["usd_per_h"] * cnt if ok else U}
            total = g["usd_per_h"] * cnt * wh if ok and wh is not None else U
            basis, ceiling = "gpu_hours", tok / ntr if tok != U and ntr else U
        else:
            total, basis, ceiling = tok, "tokens", U
        pt, succ = per_task_cost(total)
        m12[role] = {"model": m, "source": "gateway", "outside_gateway": False, **a, "usd_total": total,
                     "usd_per_task": pt, "usd_per_successful_task": succ, "basis": basis,
                     "token_ceiling_usd_per_task": ceiling, **({"gpu_hosts": gpu} if role == "policy" else {})}
    lj = {"model": U, "source": "label rows", "outside_gateway": True, "calls": U, "ok": U, "prompt_tokens": U,
          "completion_tokens": U, "usd_total": U, "usd_per_task": U, "usd_per_successful_task": U, "basis": "tokens",
          "token_ceiling_usd_per_task": U}
    if labels:
        if os.path.isdir(labels):
            files = sorted(os.path.join(d, n) for d, _, fs in os.walk(labels) for n in fs)
        elif os.path.exists(labels):
            files = [labels]
        else:
            raise Fail(f"--labels {labels} does not exist")
        rows = [r for p in files if p.endswith(".jsonl") for r in jsonl(p, "label rows")
                if isinstance(r, dict) and r.get("level") == 1 and isinstance(r.get("usage"), dict)]
        foreign = [r for r in rows if r.get("run") not in seen]
        rows = [r for r in rows if r.get("run") in seen]
        if foreign:
            warnings.append(f"{len(foreign)} label rows for runs outside this fleet ignored")
        ms = {str(r.get("model")) for r in rows}
        if not rows:
            lj.update({"calls": 0, "ok": 0, "prompt_tokens": 0, "completion_tokens": 0, "usd_total": 0.0, "usd_per_task": 0.0,
                       "usd_per_successful_task": 0.0 if pass1 != U and pass1 > 0 else U})
        elif len(ms) == 1:
            m = ms.pop()
            ptk = sum(r["usage"].get("prompt_tokens") or 0 for r in rows)
            ctk = sum(r["usage"].get("completion_tokens") or 0 for r in rows)
            total = price(m, ptk, ctk)
            pt, succ = per_task_cost(total)
            lj.update({"model": m, "calls": len(rows), "ok": len(rows), "prompt_tokens": ptk, "completion_tokens": ctk,
                       "usd_total": total, "usd_per_task": pt, "usd_per_successful_task": succ})
        else:
            warnings.append("label rows name more than one model: " + ", ".join(sorted(ms)))
    m12["label_judge"] = lj
    un_models = sorted(m for m in agg if m not in roles.values())
    un = {k: sum(agg[m][k] for m in un_models) for k in zero}
    tot = 0.0
    for m in un_models:
        pr = price(m, agg[m]["prompt_tokens"], agg[m]["completion_tokens"], agg[m]["calls"])
        tot = U if U in (pr, tot) else tot + pr
    m12["unattributed"] = {"models": un_models, **un, "usd_total": tot}
    if un_models:
        warnings.append("unattributed models: " + ", ".join(un_models))

    walls = [t["wall_ms"] / 1000 for t in done if t["wall_ms"] is not None]
    m13 = {"n": len(walls), "median_s": statistics.median(walls) if walls else U,
           "p90_s": sorted(walls)[math.ceil(0.9 * len(walls)) - 1] if walls else U,
           "worst_s": max(walls) if walls else U, "concurrency": meta.get("concurrency")}
    f = hosts.get("fleet") if isinstance(hosts.get("fleet"), dict) else {}
    rate = f.get("usd_per_h") if num(f.get("usd_per_h")) else U
    m16 = {"host_usd_per_h": rate, "fleet_wall_h": wh if wh is not None else U, "completed": len(done),
           "value": rate * wh / len(done) if rate != U and wh is not None and done else U}
    bl = {}
    base = prices.get("baselines") if isinstance(prices.get("baselines"), dict) else {}
    med = m13["median_s"]
    for name, b in sorted(base.items()):
        try:
            if med == U:
                raise KeyError("median")
            if b["kind"] == "vm":
                bl[name] = b["usd_per_h"] * max(b["min_s"], med + b["boot_s"]) / 3600
            elif b["kind"] == "serverless":
                bl[name] = (b["vcpu"] * b["usd_per_vcpu_h"] + b["gb"] * b["usd_per_gb_h"]) * max(b["min_s"], med) / 3600
            else:
                bl[name] = U
        except (KeyError, TypeError):
            bl[name] = U
    m16["baselines"] = bl
    nums = [v for v in bl.values() if v != U]
    m16["ratio_to_best_baseline"] = m16["value"] / min(nums) if nums and m16["value"] != U and min(nums) > 0 else U

    out = {"m2": m2, "m8": m8, "m11": m11, "m12": m12, "m13": m13, "m16": m16, "trials": trials,
           "warnings": sorted(warnings),
           "inputs": {"fleet": meta.get("fleet"), "trials_per_task": meta.get("trials_per_task"),
                      "concurrency": meta.get("concurrency"), "roles": roles, "prices_sha256": sha_file(prices_path),
                      "split": meta.get("split"), **({"policy_route": pr} if pr is not None else {})}}
    paths = []

    def walk(o, p):
        if o == U:
            paths.append(p)
        elif isinstance(o, dict):
            for k, v in o.items():
                walk(v, f"{p}.{k}")
    for k in ("m2", "m8", "m11", "m12", "m13", "m16"):
        walk(out[k], k)
    for t in trials:
        for k in ("llm", "host_side_ms", "m8"):
            walk(t[k], f"trials.{t['run']}.{k}")
    out["unverified"] = sorted(paths)
    return out


def fmt(v, pct=False):
    if v is None:
        return "n/a"
    if isinstance(v, str) or isinstance(v, bool):
        return str(v)
    if isinstance(v, float):
        return f"{100 * v:.1f}%" if pct else f"{v:.6g}"
    if isinstance(v, list):
        return "[" + ", ".join(fmt(x, pct) for x in v) + "]"
    return str(v)


def matrix_text(g):
    m2, m8, m11, m12, m13, m16 = (g[k] for k in ("m2", "m8", "m11", "m12", "m13", "m16"))
    i = g["inputs"]
    out = [f"fleet {i['fleet']}: {i['trials_per_task']} trials/task at concurrency {i['concurrency']}, "
           f"split {i['split'].get('part') if isinstance(i['split'], dict) else 'n/a'}, prices sha256 {i['prices_sha256'][:12]}",
           "", f"M2 harness_e2e_pass  {m2['done']}/{m2['trials']} done = {fmt(m2['value'], True)}",
           "", f"M8 trace_completeness  complete {m8['complete']}, incomplete {m8['incomplete']}, unverified {m8['unverified']}; "
               f"mean ratio {fmt(m8['mean_ratio'])}",
           "", f"M11 pass^1 {fmt(m11['pass1'])} ci95 {fmt(m11['pass1_ci95'])}   pass^4 {fmt(m11['pass4'])} ci95 "
               f"{fmt(m11['pass4_ci95'])}   Avg@4 {fmt(m11['avg4'])} ci95 {fmt(m11['avg4_ci95'])}",
           f"    infra-excluded trials {m11['infra_excluded']}; tasks short of 4 valid: {','.join(m11['tasks_short_4']) or '-'}; "
           f"all-infra tasks: {','.join(m11['tasks_all_infra']) or '-'}",
           f"    causes ({m11['by_class']['agent']} agent, {m11['by_class']['infra']} infra): "
           + (", ".join(f"{k} {v}" for k, v in m11["causes"].items()) or "-"),
           "    task  trials  n  c  infra  pass^1  pass^4  Avg@4"]
    out += [f"    {p['task']:>4}  {p['trials']:>6}  {p['n']}  {p['c']}  {p['infra']:>5}  {fmt(p['pass1'])}  {fmt(p['pass4'])}  "
            f"{fmt(p['avg4'])}" for p in m11["tasks"]]
    out += ["", "M12 cost per role (USD)  role: model [source] calls/ok, prompt+completion tokens -> total, per task, "
                "per successful task (basis; token ceiling per task)"]
    for r in ("policy", "simulator", "nl_judge", "label_judge"):
        x = m12[r]
        out.append(f"    {r}: {x['model']} [{x['source']}{', outside the gateway' if x['outside_gateway'] else ''}] "
                   f"{fmt(x['calls'])}/{fmt(x['ok'])}, {fmt(x['prompt_tokens'])}+{fmt(x['completion_tokens'])} -> "
                   f"{fmt(x['usd_total'])}, {fmt(x['usd_per_task'])}, {fmt(x['usd_per_successful_task'])} "
                   f"({x['basis']}; ceiling {fmt(x['token_ceiling_usd_per_task'])})")
    h = m12["policy"].get("gpu_hosts")
    if h:
        out.append(f"    policy GPU hosts: {fmt(h['name'])} {fmt(h['count'])} × {fmt(h['usd_per_h'])} $/h = {fmt(h['usd_per_h_total'])} $/h")
    else:
        u = m12["policy"]["usage"]
        out.append(f"    policy billed usage: input {u['input_tokens']}, cache write {u['cache_creation_input_tokens']}, cache read "
                   f"{u['cache_read_input_tokens']}, output {u['output_tokens']} (thinking {u['thinking_tokens']}); uncached "
                   f"ceiling {fmt(m12['policy']['uncached_ceiling_usd_per_task'])} per task")
    u = m12["unattributed"]
    out.append(f"    unattributed: {', '.join(u['models']) or '-'} {u['calls']}/{u['ok']}, "
               f"{u['prompt_tokens']}+{u['completion_tokens']} -> {fmt(u['usd_total'])}")
    out += ["", f"M13 latency_per_task  n {m13['n']}, median {fmt(m13['median_s'])} s, p90 {fmt(m13['p90_s'])} s, "
                f"worst {fmt(m13['worst_s'])} s at concurrency {m13['concurrency']}",
            "", f"M16 infra_cost_per_trial  {fmt(m16['host_usd_per_h'])} $/h × {fmt(m16['fleet_wall_h'])} h / "
                f"{m16['completed']} done = {fmt(m16['value'])} USD; ratio to best baseline {fmt(m16['ratio_to_best_baseline'])}"]
    out += [f"    baseline {k}: {fmt(v)} USD/trial" for k, v in m16["baselines"].items()]
    out += ["", f"unverified: {', '.join(p for p in g['unverified'] if not p.startswith('trials.')) or '-'} "
                f"(+{sum(p.startswith('trials.') for p in g['unverified'])} per-trial parts)"]
    out += [f"warning: {w}" for w in g["warnings"]]
    return "\n".join(out) + "\n"


def cmd_matrix(a):
    g = matrix(a.fleet, a.prices, a.labels)
    js = json.dumps(g, sort_keys=True)
    if a.out:
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(js + "\n")
    sys.stdout.write(js + "\n" if a.json else matrix_text(g))
    return 0


# ---------------------------------------------------------------- m17 (§7)

def m17(sweep):
    try:
        names = [n for n in os.listdir(sweep) if n.startswith("level_") and os.path.isdir(os.path.join(sweep, n))]
    except OSError as e:
        raise Fail(f"{sweep} unreadable: {e}")
    if not names:
        raise Fail(f"{sweep} has no level_* directories")
    levels = []
    for n in names:
        meta, lines = fleet_meta(os.path.join(sweep, n))
        lines = [l for l in lines if not l.get("interrupted")]
        hs, walls, llms, skipped = [], [], [], 0
        for ln in lines:
            t = trial(meta["results_root"], ln["run"], str(ln["task"]), ln.get("slot"), meta["roles"])
            if t["status"] != "done":
                continue
            if t["llm"] == U or t["wall_ms"] is None:
                skipped += 1
                continue
            hs.append(t["host_side_ms"])
            walls.append(t["wall_ms"])
            llms.append(t["llm"]["ms"])
        peak = meta.get("peak_guest_mem_mib")
        levels.append({"concurrency": meta["concurrency"], "trials": len(lines), "skipped": skipped,
                       "host_side_ms": {"median": statistics.median(hs), "n": len(hs)} if hs else U,
                       "wall_ms_median": statistics.median(walls) if walls else U,
                       "llm_ms_median": statistics.median(llms) if llms else U,
                       "peak_guest_mem_mib": peak if num(peak) else U})
    levels.sort(key=lambda l: l["concurrency"])
    out = {"levels": levels, "rule": RULE, "baseline_concurrency": levels[0]["concurrency"]}
    if levels[0]["host_side_ms"] == U:
        return {**out, "baseline_host_side_ms": U, "m17": U, "ceiling_reached": False}
    base = levels[0]["host_side_ms"]["median"]
    best, reached = levels[0]["concurrency"], False
    for l in levels[1:]:
        if l["host_side_ms"] == U or l["host_side_ms"]["median"] > 1.05 * base:
            reached = l["host_side_ms"] != U
            break
        best = l["concurrency"]
    return {**out, "baseline_host_side_ms": base, "m17": best, "ceiling_reached": reached}


def emit_m17(d, as_json):
    g = m17(d)
    if as_json:
        print(json.dumps(g, sort_keys=True))
        return 0
    print("level  trials  skipped  host-side median ms (n)  wall median ms  llm median ms  peak guest MiB")
    for l in g["levels"]:
        h = l["host_side_ms"]
        hs = U if h == U else f"{fmt(h['median'])} ({h['n']})"
        print(f"{l['concurrency']:>5}  {l['trials']:>6}  {l['skipped']:>7}  {hs:>24}  {fmt(l['wall_ms_median']):>14}  "
              f"{fmt(l['llm_ms_median']):>13}  {fmt(l['peak_guest_mem_mib'])}")
    print(f"M17 density: {g['m17']} (baseline level {g['baseline_concurrency']}, {fmt(g['baseline_host_side_ms'])} ms; "
          f"ceiling {'reached' if g['ceiling_reached'] else 'not reached'}; rule: {g['rule']})")
    return 0


# ---------------------------------------------------------------- compare (train/CONTRACT.md §8)

def trio(va, vb):
    return {"a": va, "b": vb, "diff": vb - va if num(va) and num(vb) else U}


def dig(m, *path):
    for p in path:
        m = m.get(p, U) if isinstance(m, dict) else U
    return m


def compare(pa, pb, seed=300):
    a, b = load(pa, "matrix A"), load(pb, "matrix B")
    for side, m, p in (("a", a, pa), ("b", b, pb)):
        if not isinstance(m, dict) or not all(isinstance(m.get(k), dict) for k in ("inputs", "m11", "m12", "m13")) \
                or not isinstance(m["m11"].get("tasks"), list):
            raise Fail(f"{p} is not a fleet matrix (needs inputs, m11.tasks, m12, m13)")
        for t in m["m11"]["tasks"]:
            if not isinstance(t, dict) or not all(num(t.get(k)) for k in ("n", "c")) or "task" not in t:
                raise Fail(f"{p}: a task lacks task, n or c: {t}")
            for k in (1, 4):
                want, got = pass_k(t["c"], t["n"], k), t.get(f"pass{k}")
                if (want is None) != (got is None) or want is not None and (not num(got) or abs(got - want) > 1e-9):
                    raise Fail(f"{side}: task {t['task']} pass{k} {got} is not C(c,{k})/C(n,{k}) of n {t['n']}, c {t['c']}", 1)
    for path in (("split", "sha256"), ("split", "part"), ("roles", "simulator"), ("roles", "nl_judge")):
        va, vb = dig(a["inputs"], *path), dig(b["inputs"], *path)
        if va != vb:
            raise Fail(f"inputs.{'.'.join(path)} differ: a {va}, b {vb}", 1)
    ta = {t["task"]: t for t in a["m11"]["tasks"]}
    tb = {t["task"]: t for t in b["m11"]["tasks"]}
    paired = [t for t in ta if t in tb]
    if not paired:
        raise Fail("no task is in both matrices", 1)
    out = {"format": "avos-fleet-compare/1", "paired_tasks": paired, "a_only": sorted(set(ta) - set(tb)),
           "b_only": sorted(set(tb) - set(ta)), "bootstrap": {"seed": seed, "B": 2000, "rule": "paired percentile bootstrap over tasks"}}
    for side, m in (("a", a), ("b", b)):
        i = m["inputs"]
        out[side] = {"fleet": i.get("fleet"), "policy": dig(i, "roles", "policy"), "trials_per_task": i.get("trials_per_task"),
                     "concurrency": i.get("concurrency"), "tasks": len(m["m11"]["tasks"])}
    out["warnings"] = sorted(f"{k} differ: a {out['a'][k]}, b {out['b'][k]}" for k in ("trials_per_task", "concurrency")
                             if out["a"][k] != out["b"][k])
    rows = []
    for t in paired:
        row = {"task": t}
        for side, src in (("a", ta), ("b", tb)):
            n, c = src[t]["n"], src[t]["c"]
            row[side] = {"n": n, "c": c, "pass1": pass_k(c, n, 1), "pass4": pass_k(c, n, 4)}
        for k in ("pass1", "pass4"):
            row["d_" + k] = None if row["a"][k] is None or row["b"][k] is None else row["b"][k] - row["a"][k]
        rows.append(row)
    out["tasks"] = rows
    for k in ("pass1", "pass4"):
        both = [r for r in rows if r["d_" + k] is not None]
        if both:
            d = [r["d_" + k] for r in both]
            out[k] = {"a": statistics.fmean(r["a"][k] for r in both), "b": statistics.fmean(r["b"][k] for r in both),
                      "diff": statistics.fmean(d), "ci95": ci95(d, seed), "tasks": len(both)}
        else:
            out[k] = {"a": U, "b": U, "diff": U, "ci95": U, "tasks": 0}
    out["m12"] = {f"{role}_usd_per_task": trio(dig(a, "m12", role, "usd_per_task"), dig(b, "m12", role, "usd_per_task"))
                  for role in ("policy", "simulator", "nl_judge")}
    out["m12"]["policy_usd_per_successful_task"] = trio(dig(a, "m12", "policy", "usd_per_successful_task"),
                                                        dig(b, "m12", "policy", "usd_per_successful_task"))
    out["m13"] = {k: trio(dig(a, "m13", k), dig(b, "m13", k)) for k in ("median_s", "p90_s", "worst_s")}
    ca, cb = a["m11"].get("causes") or {}, b["m11"].get("causes") or {}
    out["causes"] = {"a": dict(sorted(ca.items())), "b": dict(sorted(cb.items())),
                     "diff": {c: cb.get(c, 0) - ca.get(c, 0) for c in sorted(set(ca) | set(cb))}}
    out["by_class"] = {c: trio((a["m11"].get("by_class") or {}).get(c, 0), (b["m11"].get("by_class") or {}).get(c, 0))
                       for c in ("agent", "infra")}
    return out


def compare_text(g):
    a, b = g["a"], g["b"]
    out = [f"A {a['fleet']} ({a['policy']}, {a['trials_per_task']} trials/task, concurrency {a['concurrency']}, {a['tasks']} tasks)",
           f"B {b['fleet']} ({b['policy']}, {b['trials_per_task']} trials/task, concurrency {b['concurrency']}, {b['tasks']} tasks)",
           f"paired {len(g['paired_tasks'])} tasks; A only: {','.join(g['a_only']) or '-'}; B only: {','.join(g['b_only']) or '-'}"]
    for k, name in (("pass1", "pass^1"), ("pass4", "pass^4")):
        x = g[k]
        out += ["", f"{name}  A {fmt(x['a'])}  B {fmt(x['b'])}  B − A {fmt(x['diff'])} ci95 {fmt(x['ci95'])} over {x['tasks']} tasks "
                    f"({g['bootstrap']['rule']}, seed {g['bootstrap']['seed']}, B {g['bootstrap']['B']})"]
    out += ["", "per task  n/c A  n/c B  d pass^1  d pass^4"]
    out += [f"    {t['task']:>4}  {t['a']['n']}/{t['a']['c']}  {t['b']['n']}/{t['b']['c']}  {fmt(t['d_pass1'])}  {fmt(t['d_pass4'])}"
            for t in g["tasks"]]
    for block in ("m12", "m13", "by_class"):
        out += ["", f"{block.upper() if block != 'by_class' else 'causes by class'}  (A, B, B − A)"]
        out += [f"    {k}: {fmt(v['a'])}, {fmt(v['b'])}, {fmt(v['diff'])}" for k, v in g[block].items()]
    out += ["", "causes  (A, B, B − A)"]
    out += [f"    {c}: {g['causes']['a'].get(c, 0)}, {g['causes']['b'].get(c, 0)}, {d:+d}" for c, d in g["causes"]["diff"].items()] or ["    -"]
    out += [f"warning: {w}" for w in g["warnings"]]
    return "\n".join(out) + "\n"


def cmd_compare(a):
    g = compare(a.a, a.b, a.seed)
    js = json.dumps(g, sort_keys=True)
    if a.out:
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(js + "\n")
    sys.stdout.write(js + "\n" if a.json else compare_text(g))
    return 0


# ---------------------------------------------------------------- m15 (eval/CONTRACT.md §5)

def ratio(num_vals, den_vals, bar, seed=300):
    """mean(num) / mean(den) over the same tasks, with a paired percentile interval that resamples tasks and
    recomputes the ratio; resamples whose denominator is 0 are counted, never inf."""
    T = len(num_vals)
    r = {"value": None, "ci95": None, "bar": bar, "tasks": T, "undefined_resamples": 0}
    if not T:
        return {**r, "verdict": "unresolved", "reason": "no_tasks"}
    rng, ratios = random.Random(seed), []
    for _ in range(2000):
        idx = [rng.randrange(T) for _ in range(T)]
        d = statistics.fmean(den_vals[i] for i in idx)
        if d == 0:
            r["undefined_resamples"] += 1
        else:
            ratios.append(statistics.fmean(num_vals[i] for i in idx) / d)
    ratios.sort()
    if not r["undefined_resamples"]:
        r["ci95"] = [ratios[50], ratios[1949]]
    den = statistics.fmean(den_vals)
    if den == 0:
        return {**r, "verdict": "unresolved", "reason": "zero_denominator"}
    r["value"] = statistics.fmean(num_vals) / den
    if r["ci95"] is None:
        return {**r, "verdict": "unresolved", "reason": "ratio_undefined_in_bootstrap"}
    lo, hi = r["ci95"]
    return {**r, "verdict": "pass" if lo >= bar else "fail" if hi < bar else "unresolved"}


def session(path):
    """One fleet-matrix file: the facts M15 reads, its per-trial policy cost (None when one cannot be read)."""
    try:
        with open(path, "rb") as f:
            raw = f.read()
        m = json.loads(raw)
    except (OSError, ValueError) as e:
        raise Fail(f"session unreadable: {path}: {e}")
    try:
        i, tasks, pol, ntr, trials = m["inputs"], m["m11"]["tasks"], m["m12"]["policy"], m["m2"]["trials"], m["trials"]
        policy = i["roles"]["policy"]
        by_task = {str(t["task"]): t for t in tasks}
        for t in tasks:
            for k in (1, 4):
                want, got = pass_k(t["c"], t["n"], k), t.get(f"pass{k}")
                if (want is None) != (got is None) or want is not None and (not num(got) or abs(got - want) > 1e-9):
                    raise Fail(f"pass_k_mismatch: {path}: task {t['task']} pass{k} {got} is not C(c,{k})/C(n,{k}) of n {t['n']}, c {t['c']}", 1)
        if pol.get("basis") == "tokens":
            cost = [(str(t["task"]), dig(t, "llm", "by_model", policy, "usd")) for t in trials]
        else:
            each = pol.get("usd_total") / ntr if num(pol.get("usd_total")) and ntr else U
            cost = [(str(t["task"]), each) for t in trials]
    except (KeyError, TypeError, AttributeError) as e:
        raise Fail(f"not_a_matrix: {path}: {type(e).__name__} {e}", 1)
    pr = i.get("policy_route") if isinstance(i.get("policy_route"), dict) else None
    served_ = [x for x in (pr or {}).get("served") or [] if isinstance(x, dict)]
    roots = sorted({x.get("root") for x in served_}, key=str)
    return {"path": path, "sha": hashlib.sha256(raw).hexdigest(), "inputs": i, "tasks": by_task, "policy": policy, "route": pr,
            "roots": roots,
            "cost": [(t, c if num(c) else None) for t, c in cost],
            "row": {"fleet": i.get("fleet"), "path": path, "policy": policy, "trials": ntr, "pass1": m["m11"].get("pass1"),
                    "pass4": m["m11"].get("pass4"), "usd_per_task": pol.get("usd_per_task"), "basis": pol.get("basis")}}


def provenance(arms, base_root, asserted):
    """Each arm must be provable from its sessions: closed = a closed name on an anthropic route; retrained = an open
    route whose recorded served root is one checkpoint that is not the base. A session from before roots were recorded
    counts only when the operator asserts it, and is reported so."""
    claims = []
    for a in asserted:
        fleet, _, arm = a.partition("=")
        if arm != "retrained":
            raise Fail(f"--assert-served {a}: only FLEET=retrained can be asserted")
        if fleet not in [s["inputs"].get("fleet") for s in arms["retrained"]]:
            raise Fail(f"--assert-served {a}: no --retrained session is fleet {fleet}")
        claims.append(fleet)
    for s in arms["closed"]:
        if not closed(s["policy"]) or (s["route"] or {}).get("kind") != "anthropic":
            raise Fail(f"closed_arm_not_closed: {s['inputs'].get('fleet')} ({s['path']}): policy {s['policy']}, route kind "
                       f"{(s['route'] or {}).get('kind')}", 1)
        s["row"].update(provenance="recorded", served_root=None)
    for s in arms["retrained"]:
        f = s["inputs"].get("fleet")
        if closed(s["policy"]) or (s["route"] or {}).get("kind", "openai") != "openai":
            raise Fail(f"retrained_arm_not_open: {f} ({s['path']}): policy {s['policy']}, route kind {(s['route'] or {}).get('kind')}", 1)
        if None in s["roots"]:
            raise Fail(f"served_root_missing: {f} ({s['path']}) recorded its upstream's model list without a checkpoint root "
                       "(a hosted provider); it cannot prove the retrained weights, assertion or not", 1)
        if s["roots"] and f in claims:
            raise Fail(f"assertion_not_needed: {f} records its served checkpoint {s['roots']}", 1)
        if not s["roots"] and f not in claims:
            raise Fail(f"provenance_missing: {f} ({s['path']}) records no served checkpoint; name it with --assert-served {f}=retrained", 1)
        s["row"].update(provenance="recorded" if s["roots"] else "asserted, not recorded",
                        served_root=s["roots"][0] if len(s["roots"]) == 1 else None)
    rec = [s for s in arms["retrained"] if s["roots"]]
    if rec and base_root is None:
        raise Fail("--base-root ROOT is required: recorded retrained sessions are checked against the base checkpoint")
    roots = sorted({r for s in rec for r in s["roots"]})
    for s in rec:
        if base_root in s["roots"]:
            raise Fail(f"retrained_is_base: {s['inputs'].get('fleet')} served {base_root}, the base checkpoint", 1)
    if len(roots) > 1:
        raise Fail(f"retrained_checkpoint_mismatch: retrained sessions served {roots}", 1)
    return {"base_root": base_root, "assertions": [{"fleet": f, "arm": "retrained", "status": "asserted, not recorded"} for f in claims]}


def m15(retrained, closed_, seed=300, bar_x=0.75, bar_y=5.0, base_root=None, asserted=()):
    arms = {"retrained": [session(p) for p in retrained], "closed": [session(p) for p in closed_]}
    prov = provenance(arms, base_root, asserted)
    every = arms["retrained"] + arms["closed"]
    names = lambda ss: [s["path"] for s in ss]
    for k in ("fleet", "sha"):
        seen = {}
        for s in every:
            v = s["inputs"].get("fleet") if k == "fleet" else s["sha"]
            if v in seen:
                raise Fail(f"duplicate_session: {seen[v]} and {s['path']} are the same session ({k})", 1)
            seen[v] = s["path"]
    for arm, ss in arms.items():
        if len({s["policy"] for s in ss}) > 1:
            raise Fail(f"policy_mismatch: the {arm} sessions name {sorted({s['policy'] for s in ss})}: {names(ss)}", 1)
    for why, get in (("task_sets_differ", lambda s: sorted(s["tasks"])), ("split_mismatch", lambda s: (dig(s["inputs"], "split", "sha256"), dig(s["inputs"], "split", "part"))),
                     ("simulator_mismatch", lambda s: dig(s["inputs"], "roles", "simulator")), ("judge_mismatch", lambda s: dig(s["inputs"], "roles", "nl_judge"))):
        bad = [s["path"] for s in every if get(s) != get(every[0])]
        if bad:
            raise Fail(f"{why}: {every[0]['path']} vs {', '.join(bad)}", 1)
    ids = list(every[0]["tasks"])
    ids.sort(key=lambda t: (0, int(t), t) if t.isdigit() else (1, 0, t))
    out = {"format": "avos-m15/1", "bootstrap": {"seed": seed, "B": 2000, "rule": "paired percentile bootstrap over tasks"},
           "tasks": ids, "arms": {}}
    pk, costs = {}, {}
    for arm, ss in arms.items():
        nc = {t: [sum(s["tasks"][t][k] for s in ss) for k in ("n", "c", "trials")] for t in ids}
        p = {k: {t: pass_k(nc[t][1], nc[t][0], k) for t in ids} for k in (1, 4)}
        spent = {t: [c for s in ss for task, c in s["cost"] if task == t] for t in ids}
        readable = all(c is not None for s in ss for _, c in s["cost"])
        costs[arm] = {t: statistics.fmean(v) for t, v in spent.items() if v} if readable else None
        pk[arm] = p
        pooled = {}
        for k in (1, 4):
            vals = [p[k][t] for t in ids if p[k][t] is not None]
            pooled[f"pass{k}"] = statistics.fmean(vals) if vals else U
            pooled[f"pass{k}_ci95"] = ci95(vals, seed) if vals else U
        cv = list(costs[arm].values()) if costs[arm] else []
        pooled["usd_per_task"] = statistics.fmean(cv) if cv else U
        pooled["usd_per_successful_task"] = pooled["usd_per_task"] / pooled["pass1"] \
            if pooled["usd_per_task"] != U and pooled["pass1"] != U and pooled["pass1"] > 0 else U
        pooled["trials"] = sum(v[2] for v in nc.values())
        out["arms"][arm] = {"sessions": [s["row"] for s in ss], "pooled": pooled,
                            "per_task": {t: {"n": nc[t][0], "c": nc[t][1]} for t in ids},
                            "tasks_short_4": [t for t in ids if p[4][t] is None]}
    both = [t for t in ids if pk["retrained"][4][t] is not None and pk["closed"][4][t] is not None]
    r4, c4 = [pk["retrained"][4][t] for t in both], [pk["closed"][4][t] for t in both]
    d4 = [a - b for a, b in zip(r4, c4)]
    out["diff_pass4"] = {"value": statistics.fmean(d4) if d4 else U, "ci95": ci95(d4, seed) if d4 else U, "tasks": len(both)}
    out["x"] = ratio(r4, c4, bar_x, seed)
    if costs["retrained"] is None or costs["closed"] is None:
        out["y"] = {"value": None, "ci95": None, "bar": bar_y, "tasks": 0, "undefined_resamples": 0, "verdict": "unresolved",
                    "reason": "cost_unverified"}
    else:
        cb = [t for t in ids if t in costs["retrained"] and t in costs["closed"]]
        out["y"] = ratio([costs["closed"][t] for t in cb], [costs["retrained"][t] for t in cb], bar_y, seed)
    out["provenance"] = prov
    out["warnings"] = sorted(f"{k} differ between sessions: " + ", ".join(f"{s['row']['fleet']} {s['inputs'].get(k)}" for s in every)
                             for k in ("trials_per_task", "concurrency") if len({s["inputs"].get(k) for s in every}) > 1)
    return out


def m15_text(g):
    pv = g["provenance"]
    out = [f"M15 over {len(g['tasks'])} tasks ({g['bootstrap']['rule']}, seed {g['bootstrap']['seed']}, B {g['bootstrap']['B']})"]
    for arm in ("retrained", "closed"):
        a = g["arms"][arm]
        p = a["pooled"]
        out += ["", f"{arm}: pooled {p['trials']} trials, pass^1 {fmt(p['pass1'])} ci95 {fmt(p['pass1_ci95'])}, "
                    f"pass^4 {fmt(p['pass4'])} ci95 {fmt(p['pass4_ci95'])}, usd/task {fmt(p['usd_per_task'])}, "
                    f"usd/successful task {fmt(p['usd_per_successful_task'])}; tasks short of 4: {','.join(a['tasks_short_4']) or '-'}"]
        out += [f"    session {s['fleet']} ({s['policy']}, {s['basis']}; {s['provenance']}"
                + (f", served {s['served_root']}" if s["served_root"] else "") + f"): {s['trials']} trials, pass^1 {fmt(s['pass1'])}, "
                f"pass^4 {fmt(s['pass4'])}, usd/task {fmt(s['usd_per_task'])}" for s in a["sessions"]]
    d = g["diff_pass4"]
    out += ["", f"pass^4 retrained − closed {fmt(d['value'])} ci95 {fmt(d['ci95'])} over {d['tasks']} tasks"]
    for k, name in (("x", "X = retrained pass^4 / closed pass^4"), ("y", "Y = closed usd/task / retrained usd/task")):
        x = g[k]
        out.append(f"{name}  {fmt(x['value'])} ci95 {fmt(x['ci95'])} over {x['tasks']} tasks ≥ {fmt(x['bar'])} → {x['verdict']}"
                   + (f" ({x['reason']})" if x.get("reason") else ""))
    out.append(f"base checkpoint {pv['base_root'] or '-'}; asserted, not recorded: {', '.join(x['fleet'] for x in pv['assertions']) or '-'}")
    out += [f"warning: {w}" for w in g["warnings"]]
    return "\n".join(out) + "\n"


def cmd_m15(a):
    g = m15(a.retrained, a.closed, a.seed, a.bar_x, a.bar_y, a.base_root, a.assert_served or ())
    js = json.dumps(g, sort_keys=True)
    if a.out:
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(js + "\n")
    sys.stdout.write(js + "\n" if a.json else m15_text(g))
    return 0


# ---------------------------------------------------------------- cli

class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"fleet: {message}", file=sys.stderr)
        sys.exit(2)


def run_options(p):
    p.add_argument("--out", required=True)
    p.add_argument("--tasks")
    p.add_argument("--part", choices=("train", "held_out"), default="train")
    p.add_argument("--trials", type=int, required=True)
    p.add_argument("--split", default=SPLIT)
    p.add_argument("--results")
    p.add_argument("--mem-mib", type=int, default=int(os.environ.get("MEM_MIB") or 2048))
    p.add_argument("--policy", default=ROLES["policy"])
    p.add_argument("--simulator", default=ROLES["simulator"])
    p.add_argument("--judge", default=ROLES["nl_judge"])
    p.add_argument("--agent-temperature", type=float, default=0.0)
    p.add_argument("--agent-top-p", type=float)
    p.add_argument("--slots")
    p.add_argument("--job")
    p.add_argument("--name")
    p.add_argument("--json", action="store_true")


def main():
    ap = Parser(prog="fleet", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=Parser)
    r = sub.add_parser("run")
    run_options(r)
    r.add_argument("--concurrency", type=int, required=True)
    s = sub.add_parser("sweep")
    run_options(s)
    s.add_argument("--levels", required=True)
    m = sub.add_parser("matrix")
    m.add_argument("--fleet", required=True)
    m.add_argument("--prices", required=True)
    m.add_argument("--labels")
    m.add_argument("--json", action="store_true")
    m.add_argument("--out")
    c = sub.add_parser("compare")
    c.add_argument("--a", required=True)
    c.add_argument("--b", required=True)
    c.add_argument("--seed", type=int, default=300)
    c.add_argument("--json", action="store_true")
    c.add_argument("--out")
    q = sub.add_parser("m15")
    q.add_argument("--retrained", action="append", required=True, metavar="MATRIX")
    q.add_argument("--closed", action="append", required=True, metavar="MATRIX")
    q.add_argument("--base-root")
    q.add_argument("--assert-served", action="append", metavar="FLEET=retrained")
    q.add_argument("--seed", type=int, default=300)
    q.add_argument("--bar-x", type=float, default=0.75)
    q.add_argument("--bar-y", type=float, default=5.0)
    q.add_argument("--json", action="store_true")
    q.add_argument("--out")
    k = sub.add_parser("m17")
    k.add_argument("dir")
    k.add_argument("--json", action="store_true")
    a = ap.parse_args()
    try:
        if a.cmd == "m17":
            return emit_m17(a.dir, a.json)
        return {"run": cmd_run, "sweep": cmd_sweep, "matrix": cmd_matrix, "compare": cmd_compare, "m15": cmd_m15}[a.cmd](a)
    except Fail as e:
        print(f"fleet: {e}", file=sys.stderr)
        return e.code
    except Exception as e:
        print(f"fleet: error: {type(e).__name__}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
